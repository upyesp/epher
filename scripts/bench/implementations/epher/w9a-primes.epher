def isprime(n) do
  if n < 2 then return 0 == 1
  for d in 2 to floor(sqrt(n)) do if mod(n, d) == 0 then return 0 == 1
  1 == 1
end

total = 0
for n in 2 to 2000 do if isprime(n) then total = total + 1
for n in 2001 to 4000 do if isprime(n) then total = total + 1
for n in 4001 to 6000 do if isprime(n) then total = total + 1
for n in 6001 to 8000 do if isprime(n) then total = total + 1
for n in 8001 to 10000 do if isprime(n) then total = total + 1
total
