<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <!-- Microsoft.VSSDK.BuildTools (below) sets VSToolsPath to its own
         tools directory, so the build does not require the VS SDK to be
         installed; this is only the fallback. -->
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
  </PropertyGroup>
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectTypeGuids>{82b43b9b-a64c-4715-b499-d71e9ca2bd60};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <ProjectGuid>{6D3F5F1E-8B0C-4CDB-9B2E-A0E97C0A5C41}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>Epher.VisualStudio</RootNamespace>
    <AssemblyName>Epher.VisualStudio</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <!-- The package's own registration (EpherPackage.cs: the Packages
         and Menus entries) is generated from its attributes at build
         time; the hand-authored Epher.pkgdef below stays for the
         grammar and language configuration, and both merge at install. -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <!-- GeneratePkgDef writes a CodeBase value pointing at the assembly
         in the package folder: the long-standing way a VSIX-packaged
         package class loads. -->
    <RegisterWithCodebase>true</RegisterWithCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <DeployExtension>false</DeployExtension>
    <!-- The extension's version and, with it, the release the first-use
         download resolves (releases/download/v<version>/..., ADR-0066).
         CI overrides it with /p:EpherVersion=...; the vsix manifest and
         the assembly's file version are stamped from it at build time. -->
    <EpherVersion Condition="'$(EpherVersion)' == ''">0.5.52</EpherVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="EpherContentType.cs" />
    <Compile Include="EpherDocumentObserver.cs" />
    <Compile Include="EpherInlayHints.cs" />
    <Compile Include="EpherKeyProcessor.cs" />
    <Compile Include="EpherLanguageClient.cs" />
    <Compile Include="EpherLog.cs" />
    <Compile Include="EpherPackage.cs" />
    <Compile Include="EpherRun.cs" />
    <Compile Include="EpherViewFilter.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The command table for the run command (compiled to a .cto and
         merged into the assembly's resources by the VsSDK targets). -->
    <VSCTCompile Include="Epher.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>
  <ItemGroup>
    <!-- The pkgdef and the language configuration ride the vsix as
         content (the TextMate and Language Configuration recipes), and
         the manifest declares the pkgdef as a VsPackage asset so the
         installer merges its registry entries. -->
    <Content Include="Epher.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="epher-language-configuration.json">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- The language server itself, bundled (the ADR-0066 amendment:
         the first-use download retired for Visual Studio). CI fetches
         the windows-x86_64 asset of the release being built against
         and drops it here before packing; the local build does the
         same by hand. -->
    <Content Include="server\epher-lsp.exe">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Grammars\epher.tmLanguage">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- The extension logo: named by <Icon> in the vsix manifest so
         the Extensions manager shows it in the logo area (the 0.5.47
         review). Same artwork as the VS Code extension's icon. -->
    <Content Include="icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <!-- OleMenuCommandService inherits MenuCommandService from
         System.Design; without the reference the compiler cannot see
         AddCommand (CS0012/CS1061). -->
    <Reference Include="System.Design" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <!-- JavaScriptSerializer (EpherRun.cs) lives here; System.Web.Extensions
         is a GAC assembly in every .NET Framework 4.7.2 install, so it
         never rides the vsix. -->
    <Reference Include="System.Web.Extensions" />
    <!-- WPF: the key processor receives System.Windows.Input events and
         the answer tagger renders System.Windows.Controls adornments;
         a classic (non-SDK) library project lists these by name and
         msbuild resolves them from the targeting pack. -->
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <!-- JToken (EpherDocumentObserver.cs, the client's middle layer);
         the VSSDK LSP framework's message shape is Newtonsoft. VS
         provides the assembly in-process; compile-only like the rest
         of the LSP surface. -->
    <Reference Include="Newtonsoft.Json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reference assemblies for net472 where a targeting pack is not
         installed (CI runners); harmless when they are. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- The VsSDK build tasks and targets (CreateVsixContainer and
         friends); sets VSToolsPath itself, so no SDK install needed. -->
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
    <!-- The LSP client surface (ILanguageClient, Connection,
         CodeRemoteContentDefinition). Its dependencies supply the
         editor content type attributes and AsyncEventHandler; the
         assemblies themselves are not packed, VS provides them. -->
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" />
    <!-- The shell surfaces the run command needs (Package,
         OleMenuCommand, the text-manager and web-browsing interop
         types). Reference assemblies only: ExcludeAssets=runtime keeps
         every Visual Studio assembly out of the vsix — the IDE provides
         them, and the VsSDK targets suppress their names from the
         container anyway. -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <!-- No JSON stack of our own: the run session (EpherRun.cs) speaks
         LSP by hand over stdio and parses with JavaScriptSerializer from
         System.Web.Extensions (a framework reference above). Bundling
         StreamJsonRpc's net472 dependency chain into the vsix is exactly
         what failed to load in the field (0.5.48); the constraint now is
         zero NuGet assemblies deployed into the VS process. StreamJsonRpc
         still flows in transitively through the LanguageServer.Client
         package for the editor session, compile-only, and VS provides it
         at runtime there. -->
  </ItemGroup>
  <!-- The extension learns its own version at runtime from the
       assembly's file version (the download resolves
       releases/download/v<this version>/), so stamp it here. -->
  <Target Name="StampEpherVersion" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)EpherVersion.g.cs"
                      Lines="[assembly: System.Reflection.AssemblyFileVersion(&quot;$(EpherVersion)&quot;)]"
                      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)EpherVersion.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)EpherVersion.g.cs" />
    </ItemGroup>
  </Target>
  <!-- Keep the manifest's version in step with $(EpherVersion): the
       vsix version is the only version the user sees, and the download
       URL is keyed to it. -->
  <Target Name="PatchEpherVsixVersion"
          BeforeTargets="DetokenizeVsixManifestFile"
          Condition="'$(EpherVersion)' != '' and Exists('source.extension.vsixmanifest')">
    <PropertyGroup>
      <_VsixNamespaceDeclaration>&lt;Namespace Prefix="ns" Uri="http://schemas.microsoft.com/developer/vsx-schema/2011" /&gt;</_VsixNamespaceDeclaration>
    </PropertyGroup>
    <XmlPoke XmlInputPath="source.extension.vsixmanifest"
             Namespaces="$(_VsixNamespaceDeclaration)"
             Query="/ns:PackageManifest/ns:Metadata/ns:Identity/@Version"
             Value="$(EpherVersion)" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />
</Project>
