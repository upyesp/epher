<?xml version="1.0" encoding="utf-8"?>
<!--
  The command table (ADR-0069): one command set with one button,
  "Run Epher Script", placed in the Tools menu and in the code-window
  context menu. The command set and package GUIDs must match the
  consts in EpherPackage.cs; the button is text-only (no bitmap), which
  keeps the table free of image-catalog coupling.
-->
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- The shell command/menu ids: guidSHLMainMenu and the two parent
       menus below both come from vsshlids.h. -->
  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidEpherPackage">
    <Groups>
      <!-- The group the button belongs to on the Tools menu... -->
      <Group guid="guidEpherCommandSet" id="ToolsMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS"/>
      </Group>
      <!-- ...and the second group in the code-window context menu; a
           command may parent to only one group, so the extra placement
           is wired in CommandPlacements below. -->
      <Group guid="guidEpherCommandSet" id="EditorContextMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN"/>
      </Group>
    </Groups>
    <Buttons>
      <Button guid="guidEpherCommandSet" id="cmdidRunEpherScript" priority="0x0100" type="Button">
        <Parent guid="guidEpherCommandSet" id="ToolsMenuGroup"/>
        <Strings>
          <ButtonText>Run Epher Script</ButtonText>
          <ToolTipText>Evaluate the whole script and show the results beside the editor</ToolTipText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <CommandPlacements>
    <!-- The same button into the editor context menu (see above). -->
    <CommandPlacement guid="guidEpherCommandSet" id="cmdidRunEpherScript" priority="0x0100">
      <Parent guid="guidEpherCommandSet" id="EditorContextMenuGroup"/>
    </CommandPlacement>
  </CommandPlacements>

  <!-- F5 and Ctrl+F5 run the script over a .epher document, the same
       keys the VS Code extension answers (ADR-0069: one run story per
       editor). The bindings are scoped to the text editor, and the
       command only answers enabled over a .epher file (the package's
       BeforeQueryStatus), so over every other file type the shell
       falls through to the next binding on the chord — the shell's own
       Debug.Start / Debug.StartWithoutDebugging — and debugging keeps
       working everywhere else.

       History, because it explains the pair of mechanisms: the 0.5.49
       bindings-only attempt fell through (a lazily loaded package's
       command cannot answer the binding's QueryStatus on the first
       press), 0.5.50 answered with the EpherKeyTarget priority command
       target plus the auto-load, and the field still saw nothing — the
       0.5.51 field report. The auto-load closes the lazy-load hole
       this attempt died of, so the bindings ride again, next to the
       priority target, which stays for focus outside the editor (the
       bindings do not apply there and the two cannot double-run: the
       binding executes our command directly, so Debug.Start is never
       dispatched). -->
  <KeyBindings>
    <KeyBinding guid="guidEpherCommandSet" id="cmdidRunEpherScript" key1="F5" editor="guidTextEditor"/>
    <KeyBinding guid="guidEpherCommandSet" id="cmdidRunEpherScript" mod1="Control" key1="F5" editor="guidTextEditor"/>
  </KeyBindings>

  <Symbols>
    <!-- The text editor's command scope: the KeyBindings' editor
         attribute. The shell's own guid (vsshlids.h knows it as
         GUID_TextEditorFactory); declared here because the extern
         headers carry no guidTextEditor symbol for the vsct. -->
    <GuidSymbol name="guidTextEditor" value="{8B382828-6202-11D1-8870-0000F87579D2}"/>
    <GuidSymbol name="guidEpherPackage" value="{672BDABC-CE2C-4E12-A10C-107148209915}"/>
    <GuidSymbol name="guidEpherCommandSet" value="{2F8AD3D6-EC4C-4A64-8984-68F686E0F058}">
      <IDSymbol name="ToolsMenuGroup" value="0x1000"/>
      <IDSymbol name="EditorContextMenuGroup" value="0x1001"/>
      <IDSymbol name="cmdidRunEpherScript" value="0x0100"/>
    </GuidSymbol>
  </Symbols>
</CommandTable>
