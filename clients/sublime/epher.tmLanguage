<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Epher</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>include</key>
			<string>#comments</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#strings</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#defname</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#keywords</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#number-unit</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#numbers</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#calls</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#operators</string>
		</dict>
	</array>
	<key>repository</key>
	<dict>
		<key>calls</key>
		<dict>
			<key>captures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>entity.name.function.epher</string>
				</dict>
			</dict>
			<key>comment</key>
			<string>a name followed by a paren is a call; the parser reads the same adjacency</string>
			<key>match</key>
			<string>\b([A-Za-z_]\w*)[ \t]*(?=\()</string>
		</dict>
		<key>comments</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>begin</key>
					<string>/\*</string>
					<key>end</key>
					<string>\*/</string>
					<key>name</key>
					<string>comment.block.epher</string>
				</dict>
				<dict>
					<key>match</key>
					<string>//.*$</string>
					<key>name</key>
					<string>comment.line.double-slash.epher</string>
				</dict>
				<dict>
					<key>match</key>
					<string>#.*$</string>
					<key>name</key>
					<string>comment.line.number-sign.epher</string>
				</dict>
			</array>
		</dict>
		<key>defname</key>
		<dict>
			<key>captures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>keyword.declaration.epher</string>
				</dict>
				<key>2</key>
				<dict>
					<key>name</key>
					<string>entity.name.function.epher</string>
				</dict>
			</dict>
			<key>comment</key>
			<string>the name being defined, with or without a parameter list</string>
			<key>match</key>
			<string>\b(def)[ \t]+([A-Za-z_]\w*)</string>
		</dict>
		<key>keywords</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b(if|then|else|for|to|in|do|while|end|return|break|continue)\b</string>
					<key>name</key>
					<string>keyword.control.epher</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\b(def|const)\b</string>
					<key>name</key>
					<string>keyword.declaration.epher</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\b(and|or|not|xor)\b</string>
					<key>name</key>
					<string>keyword.operator.word.epher</string>
				</dict>
				<dict>
					<key>match</key>
					<string>\b(solve)\b</string>
					<key>name</key>
					<string>keyword.other.epher</string>
				</dict>
			</array>
		</dict>
		<key>number-unit</key>
		<dict>
			<key>captures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>constant.numeric.epher</string>
				</dict>
				<key>2</key>
				<dict>
					<key>name</key>
					<string>variable.other.unit.epher</string>
				</dict>
			</dict>
			<key>comment</key>
			<string>the m in 2 m, the h in 3.5h: a word after a number with only blanks between, never a keyword and never the imaginary i, and never across a newline. This is the baseline spelling; the language server's unit tokens are the exact rule.</string>
			<key>match</key>
			<string>\b(\d+(?:\.\d+)?(?:[eE][+-]?\d+)?i?|0[bBoOxX][0-9a-fA-F]+i?)[ \t]*(?!\b(?:and|or|not|xor|if|then|else|for|to|in|do|while|end|return|break|continue|def|const|solve|i)\b)([A-Za-z_]\w*)\b</string>
		</dict>
		<key>numbers</key>
		<dict>
			<key>comment</key>
			<string>decimal, scientific, based (0b/0o/0x), imaginary, and a leading-dot decimal</string>
			<key>match</key>
			<string>\b(?:\d+(?:\.\d+)?(?:[eE][+-]?\d+)?i?|0[bBoOxX][0-9a-fA-F]+i?|\.\d+i?)\b</string>
			<key>name</key>
			<string>constant.numeric.epher</string>
		</dict>
		<key>operators</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>&lt;&lt;|&gt;&gt;|&lt;=|&gt;=|==|!=|-&gt;|[-+*/^%&lt;&gt;=!&amp;|~]</string>
					<key>name</key>
					<string>keyword.operator.epher</string>
				</dict>
				<dict>
					<key>match</key>
					<string>[,;:]</string>
					<key>name</key>
					<string>punctuation.separator.epher</string>
				</dict>
				<dict>
					<key>match</key>
					<string>[()\[\]{}]</string>
					<key>name</key>
					<string>meta.bracket.epher</string>
				</dict>
			</array>
		</dict>
		<key>strings</key>
		<dict>
			<key>begin</key>
			<string>"</string>
			<key>end</key>
			<string>"</string>
			<key>name</key>
			<string>string.quoted.double.epher</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\\[ntr\\"]</string>
					<key>name</key>
					<string>constant.character.escape.epher</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>scopeName</key>
	<string>source.epher</string>
</dict>
</plist>
