<idea-plugin>
    <!-- epher for the JetBrains IDEs (ADR-0066, stage five): a thin
         shell that pairs the shared TextMate grammar, the shared
         snippets, and the platform's built-in LSP client with the
         shared epher-lsp binary downloaded on first use. -->
    <id>io.epher.jetbrains</id>
    <name>epher</name>
    <vendor url="https://epher.org">upyesp</vendor>

    <description><![CDATA[
    <p>The epher calculator language in your JetBrains IDE: syntax
    highlighting with bracket matching, a diagnostic for every broken
    statement, the answer rendered inline next to every statement that
    produces one, hover with canonical signatures, completion for the
    catalog and your own names, and the shared snippets.</p>
    ]]></description>

    <!-- modules.lang covers the live-templates extension point and
         implies modules.platform; the TextMate plugin carries the
         grammar machinery. There is no LSP module at 242: the LSP
         extension point lives in the IDE product itself. -->
    <depends>com.intellij.modules.lang</depends>
    <!-- The bundled TextMate plugin's id: org.jetbrains.plugins, not
         the org.intellij.plugins of the pre-2020 TextMate plugin this
         one replaced. Depending on the old id fails every install with
         "requires another plugin to be installed" even though TextMate
         Bundles is right there in the IDE. -->
    <depends>org.jetbrains.plugins.textmate</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- The platform's built-in LSP client (commercial IDEs only). -->
        <platform.lsp.serverSupportProvider implementation="io.epher.jetbrains.EpherLspServerSupportProvider"/>
        <!-- The shared grammar, packed as a TextMate bundle. -->
        <textmate.bundleProvider implementation="io.epher.jetbrains.EpherTextMateBundleProvider"/>
        <!-- The shared snippets, as native live templates (the TextMate
             snippet path is internal at 242, so the bundle ships none). -->
        <defaultLiveTemplates file="liveTemplates/epher.xml"/>
    </extensions>
</idea-plugin>
