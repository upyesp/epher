{
  "name": "epher",
  "displayName": "epher",
  "description": "The epher calculator language: answers inline next to every statement, units that convert, hover signatures, and completion \u2014 desktop, web, and the forks.",
  "version": "0.5.40",
  "publisher": "upyesp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/upyesp/epher"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "calculator",
    "calculator language",
    "units",
    "unit conversion",
    "astronomy",
    "physics",
    "lsp"
  ],
  "activationEvents": [
    "onLanguage:epher"
  ],
  "main": "./out/extension.js",
  "browser": "./dist/browser.js",
  "extensionDependencies": [
    "ms-vscode.wasm-wasi-core"
  ],
  "contributes": {
    "languages": [
      {
        "id": "epher",
        "aliases": [
          "Epher",
          "epher"
        ],
        "extensions": [
          ".epher"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "epher",
        "scopeName": "source.epher",
        "path": "./syntaxes/epher.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "epher",
        "path": "./snippets/epher.json"
      }
    ],
    "debuggers": [
      {
        "type": "epher",
        "label": "Epher",
        "languages": [
          "epher"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .epher script to run: a path, or the uri of an untitled document.",
                "default": "${workspaceFolder}/script.epher"
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Epher: Run script",
            "description": "Runs a .epher script. epher has nothing to pause or step: a debug start runs the whole script and prints the answers.",
            "body": {
              "type": "epher",
              "request": "launch",
              "name": "Run epher script",
              "program": "^\"\\${workspaceFolder}/${1:script.epher}\""
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "epher.runScript",
        "title": "Epher: Run Script",
        "icon": "$(play)"
      }
    ],
    "keybindings": [
      {
        "command": "epher.runScript",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == epher"
      }
    ]
  },
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "compile": "npm run sync-assets && tsc -p . && tsc -p tsconfig.web.json && npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --format=cjs --platform=node --external:vscode --sourcemap && esbuild src/browser.ts --bundle --outfile=dist/browser.js --format=cjs --platform=browser --external:vscode --sourcemap",
    "watch": "tsc -p . --watch"
  },
  "dependencies": {
    "@vscode/wasm-wasi": "^1.0.1",
    "@vscode/wasm-wasi-lsp": "0.1.0-pre.9",
    "vscode-languageclient": "^10.1.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.88.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1c1c1e",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/github/v/release/upyesp/epher?label=release&sort=semver",
      "href": "https://github.com/upyesp/epher/releases/latest",
      "description": "latest release"
    },
    {
      "url": "https://github.com/upyesp/epher/actions/workflows/release.yml/badge.svg",
      "href": "https://github.com/upyesp/epher/actions/workflows/release.yml",
      "description": "release build"
    }
  ]
}
