{
  "name": "epher",
  "displayName": "Epher",
  "description": "The epher calculator language: highlighting, answers inline next to every statement, diagnostics, hover, and completion, via the shared epher-lsp server.",
  "version": "0.5.40",
  "publisher": "upyesp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/upyesp/epher"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "calculator",
    "units",
    "astronomy",
    "language"
  ],
  "activationEvents": [
    "onLanguage:epher"
  ],
  "main": "./out/extension.js",
  "browser": "./dist/browser.js",
  "extensionDependencies": [
    "ms-vscode.wasm-wasi-core"
  ],
  "contributes": {
    "languages": [
      {
        "id": "epher",
        "aliases": [
          "Epher",
          "epher"
        ],
        "extensions": [
          ".epher"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "epher",
        "scopeName": "source.epher",
        "path": "./syntaxes/epher.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "epher",
        "path": "./snippets/epher.json"
      }
    ]
  },
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "compile": "npm run sync-assets && tsc -p . && tsc -p tsconfig.web.json && npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --format=cjs --platform=node --external:vscode --sourcemap && esbuild src/browser.ts --bundle --outfile=dist/browser.js --format=cjs --platform=browser --external:vscode --sourcemap",
    "watch": "tsc -p . --watch"
  },
  "dependencies": {
    "@vscode/wasm-wasi": "^1.0.1",
    "@vscode/wasm-wasi-lsp": "0.1.0-pre.9",
    "vscode-languageclient": "^10.1.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.88.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  }
}
