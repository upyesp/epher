{
  "def": {
    "prefix": "def",
    "body": ["def ${1:name}(${2:a}) = ${3:expr}"],
    "description": "a function defined by an expression"
  },
  "defblock": {
    "prefix": "defblock",
    "body": ["def ${1:name}(${2:a}) do", "\t${3:expr}", "end"],
    "description": "a function with a statement body"
  },
  "for": {
    "prefix": "for",
    "body": ["for ${1:k} in ${2:1} to ${3:10} do", "\t${4:expr}", "end"],
    "description": "a counted loop"
  },
  "ifexpr": {
    "prefix": "if",
    "body": ["if ${1:cond} then ${2:expr} else ${3:expr}"],
    "description": "the chooser of values"
  },
  "while": {
    "prefix": "while",
    "body": ["while ${1:cond} do ${2:expr} end"],
    "description": "a conditional loop"
  },
  "solve": {
    "prefix": "solve",
    "body": ["solve ${1:x^2 == 4}"],
    "description": "numeric equation solving"
  },
  "list": {
    "prefix": "list",
    "body": ["{${1:1, 2, 3}}"],
    "description": "a list literal"
  },
  "matrix": {
    "prefix": "matrix",
    "body": ["[[${1:1, 2}], [${2:3, 4}]]"],
    "description": "a matrix, rows of rows"
  }
}
