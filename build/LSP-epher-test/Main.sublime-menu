[
	{
		"id": "preferences",
		"children": [
			{
				"caption": "Package Settings",
				"mnemonic": "P",
				"id": "package-settings",
				"children": [
					{
						"caption": "LSP",
						"id": "lsp-settings",
						"children": [
							{
								"caption": "Servers",
								"id": "lsp-servers",
								"children": [
									{
										"caption": "LSP-epher",
										"children": [
											{
												"caption": "Settings",
												"command": "edit_settings",
												"args": {
													"base_file": "${packages}/LSP-epher/LSP-epher.sublime-settings",
													"default": "// Settings in here override those in \"LSP-epher/LSP-epher.sublime-settings\"\n\n{\n\t$0\n}\n"
												}
											}
										]
									}
								]
							}
						]
					}
				]
			}
		]
	}
]
