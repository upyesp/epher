/* ============================================================================
cofunction-identities.epher -- sine and cosine of 90 deg - x

In a right triangle the two acute angles add to 90 deg, and the sine of
one is the cosine of the other: sin(90 deg - x) = cos(x),
cos(90 deg - x) = sin(x), and dividing the two,
tan(90 deg - x) = 1 / tan(x) wherever the tangent is finite. The script
checks all three at several angles as boolean residual checks (true when
the two sides differ by less than 1e-12; double-precision noise here is
around 1e-16).

Web/desktop:             paste the whole file into the entry, press Enter

The one knob to edit is the `degs` list below (degrees, converted with
rad() because the builtin trig works in radians). The angles stay clear
of 0 and 90 deg so no tangent vanishes or blows up.
============================================================================ */

// ---- the knob ---------------------------------------------------------------
const degs = {15, 30, 45, 60, 75}   // sample angles, in degrees

// ---- the identities as residual checks ----------------------------------------
def ok_sin(x) = abs(sin(pi / 2 - x) - cos(x)) < 1e-12   // sin(90 deg - x) = cos x
def ok_cos(x) = abs(cos(pi / 2 - x) - sin(x)) < 1e-12   // cos(90 deg - x) = sin x
def ok_tan(x) = abs(tan(pi / 2 - x) - 1 / tan(x)) < 1e-12   // tan(90 deg - x) = 1 / tan x

// ---- results -----------------------------------------------------------------
// All three checks at every knob angle.
for x in degs do print("sin(90-x)=cos(x) at", x, "deg:", ok_sin(rad(x)))
for x in degs do print("cos(90-x)=sin(x) at", x, "deg:", ok_cos(rad(x)))
for x in degs do print("tan(90-x)=1/tan(x) at", x, "deg:", ok_tan(rad(x)))

// The numbers behind the booleans at 30 deg: the two sides of each check
// are sin(60 deg) = cos(30 deg) ~ 0.8660254 and tan(60 deg) = 1 / tan(30)
// ~ 1.7320508.
print("sin(90 deg - 30 deg) =", sin(rad(90) - rad(30)))
print("cos(30 deg) =", cos(30 deg))
print("tan(90 deg - 30 deg) =", tan(rad(90) - rad(30)))
print("1 / tan(30 deg) =", 1 / tan(30 deg))
/* ---- expected output
= {sin(90-x)=cos(x) at 15 deg: true, sin(90-x)=cos(x) at 30 deg: true, sin(90-x)=cos(x) at 45 deg: true, sin(90-x)=cos(x) at 60 deg: true, sin(90-x)=cos(x) at 75 deg: true}
= {cos(90-x)=sin(x) at 15 deg: true, cos(90-x)=sin(x) at 30 deg: true, cos(90-x)=sin(x) at 45 deg: true, cos(90-x)=sin(x) at 60 deg: true, cos(90-x)=sin(x) at 75 deg: true}
= {tan(90-x)=1/tan(x) at 15 deg: true, tan(90-x)=1/tan(x) at 30 deg: true, tan(90-x)=1/tan(x) at 45 deg: true, tan(90-x)=1/tan(x) at 60 deg: true, tan(90-x)=1/tan(x) at 75 deg: true}
= sin(90 deg - 30 deg) = 0.866025403784
= cos(30 deg) = 0.866025403784
= tan(90 deg - 30 deg) = 1.73205080757
= 1 / tan(30 deg) = 1.73205080757
*/