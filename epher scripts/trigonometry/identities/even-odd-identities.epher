/* ============================================================================
even-odd-identities.epher -- how sine, cosine and tangent see a minus sign

Reflecting an angle across the x-axis negates the y-coordinate on the
unit circle, so sine is odd and cosine is even: sin(-x) = -sin(x),
cos(-x) = cos(x), and their quotient makes tangent odd,
tan(-x) = -tan(x). The script checks all three at several angles as
boolean residual checks (true when the two sides differ by less than
1e-12; double-precision noise here is around 1e-16).

Run it from a terminal:
  Linux (deb, rpm):  epher /usr/lib/epher/scripts/trigonometry/identities/even-odd-identities.epher
  Windows:           epher "$env:LOCALAPPDATA\epher\scripts\trigonometry\identities\even-odd-identities.epher"
  macOS:             epher /Applications/epher.app/Contents/Resources/scripts/trigonometry/identities/even-odd-identities.epher
In the REPL:             load one of the paths above
Web/desktop:             paste the whole file into the entry, press Enter

The one knob to edit is the `degs` list below (degrees, converted with
rad() because the builtin trig works in radians).
============================================================================ */

// ---- the knob ---------------------------------------------------------------
const degs = {15, 30, 45, 60, 75}   // sample angles, in degrees

// ---- the identities as residual checks ----------------------------------------
def ok_sin(x) = abs(sin(-x) + sin(x)) < 1e-12   // sin(-x) = -sin(x)
def ok_cos(x) = abs(cos(-x) - cos(x)) < 1e-12   // cos(-x) = cos(x)
def ok_tan(x) = abs(tan(-x) + tan(x)) < 1e-12   // tan(-x) = -tan(x)

// ---- results -----------------------------------------------------------------
// All three checks at every knob angle.
for x in degs do ok_sin(rad(x))
for x in degs do ok_cos(rad(x))
for x in degs do ok_tan(rad(x))

// The numbers behind the booleans at 30 deg: sine and tangent flip sign,
// cosine does not.
print("sin(-30 deg) =", sin(-30 deg))
print("-sin(30 deg) =", -sin(30 deg))
print("cos(-30 deg) =", cos(-30 deg))
print("cos(30 deg) =", cos(30 deg))
print("tan(-30 deg) =", tan(-30 deg))
print("-tan(30 deg) =", -tan(30 deg))
/* ---- expected output
= {15, 30, 45, 60, 75}
= {true, true, true, true, true}
= {true, true, true, true, true}
= {true, true, true, true, true}
= sin(-30 deg) = -0.5
= -sin(30 deg) = -0.5
= cos(-30 deg) = 0.866025403784
= cos(30 deg) = 0.866025403784
= tan(-30 deg) = -0.57735026919
= -tan(30 deg) = -0.57735026919
*/
