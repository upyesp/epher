/* ============================================================================
double-angle-cosine.epher -- cos(2x) in its three equivalent forms

The cosine double-angle formula has three faces, all equal for every x:
cos(2x) = cos^2(x) - sin^2(x) = 2 cos^2(x) - 1 = 1 - 2 sin^2(x). The
script checks the first two against cos(2x) at several angles as boolean
residual checks (true when the sides differ by less than 1e-12;
double-precision noise here is around 1e-16).

Run it from a terminal:
  Linux (deb, rpm):  epher /usr/lib/epher/scripts/trigonometry/identities/double-angle-cosine.epher
  Windows:           epher "$env:LOCALAPPDATA\epher\scripts\trigonometry\identities\double-angle-cosine.epher"
  macOS:             epher /Applications/epher.app/Contents/Resources/scripts/trigonometry/identities/double-angle-cosine.epher
In the REPL:             load one of the paths above
Web/desktop:             paste the whole file into the entry, press Enter

The one knob to edit is the `degs` list below (degrees, converted with
rad() because the builtin trig works in radians). Twice each angle stays
under 180 deg, so no cosine double-angle value repeats.
============================================================================ */

// ---- the knob ---------------------------------------------------------------
const degs = {10, 30, 45, 60, 80}   // sample angles, in degrees

// ---- the identities as residual checks ----------------------------------------
def ok_sq(x) = abs(cos(2 * x) - (cos(x) ^ 2 - sin(x) ^ 2)) < 1e-12   // cos(2x) = cos^2 - sin^2
def ok_cs(x) = abs(cos(2 * x) - (2 * cos(x) ^ 2 - 1)) < 1e-12        // cos(2x) = 2 cos^2 - 1

// ---- results -----------------------------------------------------------------
// Both checks at every knob angle.
for x in degs do ok_sq(rad(x))
for x in degs do ok_cs(rad(x))

// The numbers behind the booleans at 60 deg: all three faces are
// cos(120 deg) = -0.5.
print("cos(2 x 60 deg) =", cos(120 deg))
print("cos^2(60 deg) - sin^2(60 deg) =", cos(60 deg) ^ 2 - sin(60 deg) ^ 2)
print("2 cos^2(60 deg) - 1 =", 2 * cos(60 deg) ^ 2 - 1)
/* ---- expected output
= {10, 30, 45, 60, 80}
= {true, true, true, true, true}
= {true, true, true, true, true}
= cos(2 x 60 deg) = -0.5
= cos^2(60 deg) - sin^2(60 deg) = -0.5
= 2 cos^2(60 deg) - 1 = -0.5
*/
