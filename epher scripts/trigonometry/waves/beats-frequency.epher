/* ============================================================================
   beats-frequency.epher -- the beat between two tuning forks

   Two tones a little apart in frequency, f1 and f2, interfere into a
   single tone whose loudness swells and fades at the beat frequency
   |f1 - f2|: the envelope of sin(2 pi f1 t) + sin(2 pi f2 t) oscillates
   at the difference (standard result of any acoustics text, e.g. Halliday,
   Resnick and Walker, "Fundamentals of Physics", ch. 17). Piano tuners
   listen for the beats between a fork and a string and turn the peg until
   they vanish.

   Run it from a terminal:  epher "epher scripts/trigonometry/waves/beats-frequency.epher"
   In the REPL:             load epher scripts/trigonometry/waves/beats-frequency.epher
   Web/desktop:             paste the whole file into the entry, press Enter

   The knobs to edit are the three frequencies below (hertz). Printed
   values carry about 12 significant digits.
   ============================================================================ */

// ---- the knobs ---------------------------------------------------------------
const f_a = 440 Hz     // the reference fork: concert A4
const f_flat = 437 Hz  // a string 3 Hz flat
const f_sharp = 443.5 Hz   // a string 3.5 Hz sharp

// ---- helpers ----------------------------------------------------------------
def beat(f1, f2) = if f1 > f2 then f1 - f2 else f2 - f1   // beat frequency of two tones (abs does not take quantities, so pick the larger)

// ---- results -----------------------------------------------------------------
// The string 3 Hz flat beats three times per second against the fork: an
// audible wah-wah-wah at 3 Hz, easy to count while tuning.
print("beat(440 Hz, 437 Hz):", beat(f_a, f_flat))

// Sharp by 3.5 Hz the beat is quicker, 3.5 per second.
print("beat(440 Hz, 443.5 Hz):", beat(f_a, f_sharp))

// The tuning target: at unison the beat vanishes, which is the null the
// ear locks onto.
print("beat(440 Hz, 440 Hz):", beat(f_a, f_a))
/* ---- expected output
= 440 Hz
= 437 Hz
= 443.5 Hz
= beat(440 Hz, 437 Hz): 3 Hz
= beat(440 Hz, 443.5 Hz): 3.5 Hz
= beat(440 Hz, 440 Hz): 0 Hz
*/
