/* ============================================================================
sinusoidal-value.epher -- y = A sin(2 pi f t + phi) at a chosen instant

A tone or a wave on a string is y(t) = A sin(2 pi f t + phi): amplitude
A, frequency f in hertz, time t in seconds, and phase phi, a knob in
degrees here that the phase term rad(phi) turns into radians. The script
evaluates the wave at the instants given below. The sample numbers are
chosen so the phase is a clean multiple of 30 deg: at t = 0.01 s with
f = 50 Hz the argument is 2 pi (0.5) + pi/6 = 7 pi/6, whose sine is
-1/2, so y = -1.25 m exactly.

Run it from a terminal:
  Linux (deb, rpm):  epher /usr/lib/epher/scripts/trigonometry/waves/sinusoidal-value.epher
  Windows:           epher "$env:LOCALAPPDATA\epher\scripts\trigonometry\waves\sinusoidal-value.epher"
  macOS:             epher /Applications/epher.app/Contents/Resources/scripts/trigonometry/waves/sinusoidal-value.epher
In the REPL:             load one of the paths above
Web/desktop:             paste the whole file into the entry, press Enter

The knobs to edit are A (meters), f (hertz), phi (degrees) and the
instants below. Printed values carry about 12 significant digits.
============================================================================ */

// ---- the knobs ---------------------------------------------------------------
const A = 2.5 m     // amplitude of the wave
const f = 50 Hz     // frequency
const phi = 30      // phase shift, degrees
const t1 = 0.01 s   // first instant to sample
const t2 = 0.005 s  // second instant to sample

// ---- helpers ----------------------------------------------------------------
def sig(t) = A * sin(2 * pi * f * t + rad(phi))   // the wave at instant t

// ---- results -----------------------------------------------------------------
// The phase shift in both measures: 30 deg is pi/6 rad ~ 0.5236.
print("phase shift:", phi, "deg =", rad(phi), "rad")

// The wave at t = 0: only the phase term survives, y = A sin(30 deg) = A/2.
print("y(0) =", sig(0 s))

// At t1 = 0.01 s the wave has run half a cycle (one period is 1/f = 0.02 s)
// plus the 30 deg phase, so y = -A sin(30 deg) = -1.25 m: the sample lands
// on the negative half of the swing.
print("y(0.01 s) =", sig(t1))

// At t2 = 0.005 s a quarter cycle has run: the argument is 2 pi/3 and
// y = A sin(120 deg) = A sqrt(3)/2 ~ 2.1651 m.
print("y(0.005 s) =", sig(t2))

// The period that paces it: 1/f = 0.02 s.
print("period:", 1 / f)
/* ---- expected output
= 2.5 m
= 50 Hz
= 30
= 0.01 s
= 0.005 s
= phase shift: 30 deg = 0.523598775598 rad
= y(0) = 1.25 m
= y(0.01 s) = -1.25 m
= y(0.005 s) = 2.16506350946 m
= period: 0.02 s
*/
