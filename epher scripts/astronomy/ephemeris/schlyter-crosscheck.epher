/* ============================================================================
schlyter-crosscheck.epher -- the classic low-precision model vs the engine

Implements Paul Schlyter's famous "How to compute planetary
positions" model (the tutorial that taught a generation of HP-41
and pocket-calculator programmers their ephemerides - the same
formula set behind countless ticalc and hpcalc programs) entirely
in this script, for the Sun and for Mars, and prints its results
beside the engine's own ephemeris (VSOP2013, JPL-Horizons-
validated). Schlyter's model is a Kepler two-body orbit with the
modern mean elements and a simple equation-of-center - no
perturbations except what the mean elements absorb.

Accuracy: Schlyter quotes about 1-2 arcminutes for the planets
between 1900 and 2100 and better than 0.01 degree for the Sun; the
mismatch column below is the honest test of that claim against the
arcsecond-grade engine. Kepler's equation is solved by the same
Newton iteration the classic programs used, written as a recursion.

Knob: the instant tm below.
============================================================================ */

// ---- the knob ----------------------------------------------------------------------
const tm = jd(2026, 9, 10, 0)

// ---- Schlyter's elements: ds = days since 2000 Jan 0.0 ---------------------------------
const ds = tm - 2451543.5

// ---- Kepler's equation by Newton's method, recursion in radians ------------------------
def kep(M, e, E) = if abs(E - e * sin(E) - M) < 1e-12 then E else kep(M, e, E - (E - e * sin(E) - M) / (1 - e * cos(E)))
def Eof(Mdeg, e) = kep(rad(Mdeg), e, rad(Mdeg) + e * sin(rad(Mdeg)))

// ---- the Sun (Schlyter's own constants) ---------------------------------------------------
const ws = 282.9404 + 4.70935e-5 * ds
const es = 0.016709 - 1.151e-9 * ds
Ms = 356.0470 + 0.9856002585 * ds
Es = Eof(Ms, es)
const xvs = cos(Es) - es
const yvs = sqrt(1 - es ^ 2) * sin(Es)
const vs = deg(atan2(yvs, xvs))
const rs = sqrt(xvs ^ 2 + yvs ^ 2)
const lsun = vs + ws                          // his geocentric ecliptic longitude of the Sun

// ---- Mars (his elements; no perturbation terms in his set for Mars) -----------------------
def wrap(x) = x - 360 * floor(x / 360)
def spread(x) = if wrap(x) > 180 then wrap(x) - 360 else wrap(x)
Nm = 49.5574 + 2.11081e-5 * ds
const incl = 1.8497 - 1.78e-8 * ds
const wm = 286.5016 + 2.92961e-5 * ds
const am = 1.523688
const em = 0.0934005 - 2.516e-9 * ds
Mm = 18.6021 + 0.5240207766 * ds
Em = Eof(Mm, em)
const xvm = am * (cos(Em) - em)
const yvm = am * sqrt(1 - em ^ 2) * sin(Em)
const vm = deg(atan2(yvm, xvm))
const rm = sqrt(xvm ^ 2 + yvm ^ 2)
// heliocentric ecliptic rectangular coordinates
const xhm = rm * (cos(rad(Nm)) * cos(rad(vm + wm)) - sin(rad(Nm)) * sin(rad(vm + wm)) * cos(rad(incl)))
const yhm = rm * (sin(rad(Nm)) * cos(rad(vm + wm)) + cos(rad(Nm)) * sin(rad(vm + wm)) * cos(rad(incl)))
const zhm = rm * sin(rad(vm + wm)) * sin(rad(incl))
// geocentric: add the Sun's rectangular position
const xgm = xhm + rs * cos(rad(lsun))
const ygm = yhm + rs * sin(rad(lsun))
const zgm = zhm
const lonm = deg(atan2(ygm, xgm))
const latm = deg(atan2(zgm, sqrt(xgm ^ 2 + ygm ^ 2)))
// equatorial with the obliquity (Schlyter: 23.4393 - 3.563e-7 * ds)
const eps = 23.4393 - 3.563e-7 * ds
const ram = deg(atan2(sin(rad(lonm)) * cos(rad(eps)) - tan(rad(latm)) * sin(rad(eps)), cos(rad(lonm))))
const decm = deg(asin(sin(rad(latm)) * cos(rad(eps)) + cos(rad(latm)) * sin(rad(eps)) * sin(rad(lonm))))

// ---- the engine's side: Sun and Mars ra/dec, and the Sun's ecliptic longitude ---------------
const mra = ra(4, tm)
const mde = decl(4, tm)
const sra = ra(10, tm)
const sde = decl(10, tm)
// engine Sun ecliptic longitude (conversion with the same eps formula)
const seps = 23.4393 - 3.563e-7 * ds
const slon = deg(atan2(sin(rad(sra)) * cos(rad(seps)) + tan(rad(sde)) * sin(rad(seps)), cos(rad(sra))))

// ---- results -----------------------------------------------------------------------------
print("Schlyter vs engine at", iso(tm))
print("Sun:   Schlyter lon", lsun, "  engine lon", slon, "  |diff|", abs(spread(lsun - slon)) * 60, "arcmin")
print("Mars ra  Schlyter", ram, "  engine", mra, "  |diff|", abs(spread(ram - mra)) * 60, "arcmin")
print("Mars dec Schlyter", decm, "  engine", mde, "  |diff|", abs(decm - mde) * 60, "arcmin")

/* ---- expected output ----
= 9965.64952038
= 173.918289618
= 49.763203975
= 5127.80467185
= 89.5903101094
= Schlyter vs engine at 2026-09-10T00:00:00
= Sun:   Schlyter lon 167.321015898   engine lon 167.319451956   |diff| 0.0938364904704 arcmin
= Mars ra  Schlyter 110.713875401   engine 110.717796062   |diff| 0.235239652319 arcmin
= Mars dec Schlyter 22.749424543   engine 22.751229886   |diff| 0.108320577118 arcmin
*/
