/* ============================================================================
orbital-elements.epher -- the mean orbital elements of the planets

Prints the mean Keplerian orbital elements of the seven classic
planets for a knob date: semi-major axis a (AU), eccentricity e,
inclination i, mean longitude L, longitude of perihelion and
longitude of the ascending node (degrees), from the epoch J2000
values and per-century rates of Meeus, "Astronomical Algorithms"
2nd ed., table 31.A (valid 1800-2050):

  element(T) = element(2000) + rate * T,  T in Julian centuries

These are the elements behind the hand-computed ephemerides of the
chapter 32-33 elliptic-motion reduction (see planet-by-hand); the
table is the classic one every almanac page reproduces. One quirk
of the printed table is kept faithfully: the EARTH row's L rate is
quoted in arcseconds per century (129597740.63) where every other
row is in degrees - the script divides that one rate by 3600.

Accuracy: the linear elements reproduce the true positions to
about an arcminute over the table's validity range; the table is
quoted as printed.

Run it from a terminal:
  Linux (deb, rpm):  epher /usr/lib/epher/scripts/astronomy/ephemeris/orbital-elements.epher
  Windows:           epher "$env:LOCALAPPDATA\epher\scripts\astronomy\ephemeris\orbital-elements.epher"
  macOS:             epher /Applications/epher.app/Contents/Resources/scripts/astronomy/ephemeris/orbital-elements.epher
In the REPL:             load one of the paths above

Knob: the date t below (as a JD from jd(...)).
============================================================================ */

// ---- the knob ---------------------------------------------------------------------
const t = jd(2026, 9, 10, 0)

// ---- table 31.A: {a, e, i, L, long.peri, node} at J2000 and per century -------------
// a in AU; angles in degrees; the Mercury..Neptune rows are Meeus's as printed.
const m = {0.387098310, 0.20563175, 7.00498602, 252.25032350, 77.45779628, 48.33076593}
const v = {0.723329820, 0.00677188, 3.39466189, 181.97970850, 131.60246718, 76.67984255}
const e = {1.000001018, 0.01670862, -0.00002622, 100.46691572, 102.93005885, 0}
const r = {1.523710340, 0.09339410, 1.84969142, -4.55343205, -23.94362959, 49.55953891}
const j = {5.202887000, 0.04838624, 1.30439695, 34.39644051, 14.72847983, 100.47390909}
const s = {9.536675940, 0.05386179, 2.48599187, 49.95424423, 92.59887831, 113.66242448}
const u = {19.189164640, 0.04725744, 0.77263783, 313.23810451, 170.95427630, 74.01692503}
const n = {30.069922760, 0.00859048, 1.77004347, -55.12002969, 44.96476227, 131.78422574}
// per-century rates: {a, e, i, L, long.peri, node}
const mr = {0, 0.00001906, -0.00594749, 149472.67411175, 0.16047689, -0.12534081}
const vr = {0, -0.00004107, -0.00083405, 58517.81560260, 0.00268329, -0.27769418}
const er = {0, -0.00004392, -0.01294668, 129597740.62963260, 0.32327364, 0}
const rr = {0, 0.00007882, -0.00813131, 19140.30268499, 0.44441088, -0.29257343}
const jr = {0, -0.00013253, -0.00183714, 3034.74612775, 0.21252668, 0.20469106}
const sr = {0, -0.00050991, 0.00193609, 1222.49362201, -0.41897216, -0.28867794}
const ur = {0, -0.00004397, -0.00242939, 428.48202785, 0.40805281, 0.04240589}
const nr = {0, 0.00005105, 0.00035372, 218.45945325, -0.32241464, -0.00508664}

// ---- helpers -------------------------------------------------------------------------
def wrap(x) = x - 360 * floor(x / 360)
def T(j) = (j - 2451545) / 36525
def ev(el, rate) = el + rate * T(t)     // elementwise: value at the knob date

// ---- the table: two lines per planet ---------------------------------------------------
print("mean orbital elements at", iso(t), "(J2000 values + table 31.A rates)")
print("a in AU; e dimensionless; angles in degrees")
print("Mercury  a", ev(m, mr)[1], " e", ev(m, mr)[2], " i", ev(m, mr)[3])
print("         L", wrap(ev(m, mr)[4]), " peri", wrap(ev(m, mr)[5]), " node", wrap(ev(m, mr)[6]))
print("Venus    a", ev(v, vr)[1], " e", ev(v, vr)[2], " i", ev(v, vr)[3])
print("         L", wrap(ev(v, vr)[4]), " peri", wrap(ev(v, vr)[5]), " node", wrap(ev(v, vr)[6]))
print("Earth    a", ev(e, er)[1], " e", ev(e, er)[2], " i", ev(e, er)[3])
print("         L", wrap(e[4] + er[4] * T(t) / 3600), " peri", wrap(ev(e, er)[5]), " node", wrap(ev(e, er)[6]))
print("Mars     a", ev(r, rr)[1], " e", ev(r, rr)[2], " i", ev(r, rr)[3])
print("         L", wrap(ev(r, rr)[4]), " peri", wrap(ev(r, rr)[5]), " node", wrap(ev(r, rr)[6]))
print("Jupiter  a", ev(j, jr)[1], " e", ev(j, jr)[2], " i", ev(j, jr)[3])
print("         L", wrap(ev(j, jr)[4]), " peri", wrap(ev(j, jr)[5]), " node", wrap(ev(j, jr)[6]))
print("Saturn   a", ev(s, sr)[1], " e", ev(s, sr)[2], " i", ev(s, sr)[3])
print("         L", wrap(ev(s, sr)[4]), " peri", wrap(ev(s, sr)[5]), " node", wrap(ev(s, sr)[6]))
print("Uranus   a", ev(u, ur)[1], " e", ev(u, ur)[2], " i", ev(u, ur)[3])
print("         L", wrap(ev(u, ur)[4]), " peri", wrap(ev(u, ur)[5]), " node", wrap(ev(u, ur)[6]))
print("Neptune  a", ev(n, nr)[1], " e", ev(n, nr)[2], " i", ev(n, nr)[3])
print("         L", wrap(ev(n, nr)[4]), " peri", wrap(ev(n, nr)[5]), " node", wrap(ev(n, nr)[6]))

/* Self-checks. The Earth row must reproduce the well-known J2000
values (a ~ 1.000000 AU, e ~ 0.01671, L near 100.5 deg, peri near
102.9 deg, node 0), and its L rate after the arcsecond division
must be 35999.37 deg/cy - the 360 deg per sidereal year the
calendar pages quote. */
print("Earth L rate (deg per century):", er[4] / 3600)

