/* ============================================================================
brightest-planet.epher -- which planet is brightest, by a search loop

Finds the planet with the smallest apparent magnitude (the brightest)
on 2026-06-01, by scanning the body numbers 1-9 (Earth, 3, is the
observer and never a target) with a while loop (guide 1.30). A loop
body is one statement, so the search state - the index, the best
magnitude so far and the best body number - is packed into one list
and updated as a whole. The magnitudes are first printed in a list;
the loop result is then checked against the list minimum from the
built-in min. Magnitudes come from the accessor mag (the solar-
ephemeris crate, JPL-validated; guide 1.16).

Knob: the date tm.
============================================================================ */

// ---- the knob ---------------------------------------------------------------
const tm = jd(2026, 6, 1)     // 0h UT

// ---- helpers ----------------------------------------------------------------
// The eight target bodies, and a name for each body number.
const bodies = {1, 2, 4, 5, 6, 7, 8, 9}
def name(b) = if b == 1 then "Mercury" else if b == 2 then "Venus" else if b == 4 then "Mars" else if b == 5 then "Jupiter" else if b == 6 then "Saturn" else if b == 7 then "Uranus" else if b == 8 then "Neptune" else "Pluto"

// ---- results ----------------------------------------------------------------
// The unrolled magnitudes, one per body in the same order: the search
// below must agree with what the eye reads off this list.
const m = {mag(1, tm), mag(2, tm), mag(4, tm), mag(5, tm), mag(6, tm), mag(7, tm), mag(8, tm), mag(9, tm)}

/* Search: s = {next index, best magnitude so far, best body number}.
Each step compares one magnitude against the best so far and keeps
the smaller (magnitude grows as brightness falls, so the minimum
magnitude is the brightest planet). */
s = {1, m[1], bodies[1]}
while s[1] < len(bodies) do s = {s[1] + 1, if m[s[1] + 1] < s[2] then m[s[1] + 1] else s[2], if m[s[1] + 1] < s[2] then bodies[s[1] + 1] else s[3]}

// The verdict, and the two checks: the best magnitude equals min of the
// list, and the body name matches the magnitude list printed above.
print("brightest planet:", name(s[3]), "at mag", s[2])
print("best mag equals min(m):", s[2] == min(m))
print("best body index:", s[3])

/* ---- expected output ----
= {1, -0.55, 1}
= brightest planet: Venus at mag -3.98
= best mag equals min(m): true
= best body index: 2
*/
