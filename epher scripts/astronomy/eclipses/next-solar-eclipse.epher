/* ============================================================================
next-solar-eclipse.epher -- the next solar eclipse, with kind and gamma

Scans lunations forward from a start date and reports the next solar
eclipse with its kind, gamma and time of maximum, using chapter 54
of Jean Meeus, "Astronomical Algorithms" (2nd ed., Willmann-Bell,
1998): the |sin F| <= 0.36 eclipse test, the shortened correction
series for the time of maximum, and the P/Q projection that gives
gamma (how centrally the Moon's shadow strikes Earth, in Earth
radii) and u (the shadow's radius there). The kind follows Meeus's
rules: u < 0 total, u > 0.0047 annular, between them hybrid, and
|gamma| beyond about 0.9972 partial only. Time comes out in TD; the
built-in delta_t (guide 1.29) converts to UT.

The same book runs inside the calculator classics - "Eclipses of
Moon and Sun" (hpcalc.org 8792) does this on an HP Prime.

Accuracy: Meeus's own grade for the method - the time of maximum
within about a minute of the canon, gamma within about 0.002. The
2026 eclipses below sit within 20 seconds of NASA's Five Millennium
Canon times (17:47:06 TD on Aug 12) and 0.0012 in gamma.

Run it from a terminal:
  Linux (deb, rpm):  epher /usr/lib/epher/scripts/astronomy/eclipses/next-solar-eclipse.epher
  Windows:           epher "$env:LOCALAPPDATA\epher\scripts\astronomy\eclipses\next-solar-eclipse.epher"
  macOS:             epher /Applications/epher.app/Contents/Resources/scripts/astronomy/eclipses/next-solar-eclipse.epher
In the REPL:             load one of the paths above

Knobs: the start date (the search begins at the new moon before or
on it) and how many lunations to allow.
============================================================================ */

// ---- the knobs ----------------------------------------------------------------
const day = {2026, 1, 1}       // search from here
const maxscan = 25             // lunations to try (a year has ~12.4)

// ---- Meeus ch. 49/54 mean elements in T = k / 1236.85 --------------------------
def e3(t) = 1 - 0.002516 * t - 0.0000074 * t ^ 2
def mp(k) = 201.5643 + 385.81693528 * k + 0.0107582 * (k / 1236.85) ^ 2 + 0.00001238 * (k / 1236.85) ^ 3 - 0.000000058 * (k / 1236.85) ^ 4
def ms(k) = 2.5534 + 29.10535670 * k - 0.0000014 * (k / 1236.85) ^ 2 - 0.00000011 * (k / 1236.85) ^ 3
def mf(k) = 160.7108 + 390.67050284 * k - 0.0016118 * (k / 1236.85) ^ 2 - 0.00000227 * (k / 1236.85) ^ 3 + 0.000000011 * (k / 1236.85) ^ 4
def node(k) = 124.7746 - 1.56375588 * k + 0.0020672 * (k / 1236.85) ^ 2 + 0.00000215 * (k / 1236.85) ^ 3
def base(k) = 2451550.09766 + 29.530588861 * k + 0.00015437 * (k / 1236.85) ^ 2 - 0.000000150 * (k / 1236.85) ^ 3 + 0.00000000073 * (k / 1236.85) ^ 4
def kb(j) = (j - 2451550.09766) / 29.530588861

// ---- ch. 54: time of maximum (TD), gamma, u for the new moon of lunation k -----
def f1(k) = mf(k) - 0.02665 * sin(rad(node(k)))
def tmax(k) = base(k) - 0.4075 * sin(rad(mp(k))) + 0.1721 * e3(k / 1236.85) * sin(rad(ms(k))) + 0.0161 * sin(rad(2 * mp(k))) - 0.0097 * sin(rad(2 * f1(k))) + 0.0073 * e3(k / 1236.85) * sin(rad(mp(k) - ms(k))) - 0.0050 * e3(k / 1236.85) * sin(rad(mp(k) + ms(k))) - 0.0023 * sin(rad(mp(k) - 2 * f1(k))) + 0.0021 * e3(k / 1236.85) * sin(rad(2 * ms(k))) + 0.0012 * sin(rad(mp(k) + 2 * f1(k))) + 0.0006 * e3(k / 1236.85) * sin(rad(2 * mp(k) + ms(k))) - 0.0004 * sin(rad(3 * mp(k))) - 0.0003 * e3(k / 1236.85) * sin(rad(ms(k) + 2 * f1(k))) + 0.0003 * sin(rad(299.77 + 0.107408 * k)) - 0.0002 * e3(k / 1236.85) * sin(rad(ms(k) - 2 * f1(k))) - 0.0002 * e3(k / 1236.85) * sin(rad(2 * mp(k) - ms(k))) - 0.0002 * sin(rad(node(k)))
def pang(k) = 0.2070 * e3(k / 1236.85) * sin(rad(ms(k))) + 0.0024 * e3(k / 1236.85) * sin(rad(2 * ms(k))) - 0.0392 * sin(rad(mp(k))) + 0.0116 * sin(rad(2 * mp(k))) - 0.0073 * e3(k / 1236.85) * sin(rad(mp(k) + ms(k))) + 0.0067 * e3(k / 1236.85) * sin(rad(mp(k) - ms(k))) + 0.0118 * sin(rad(2 * f1(k)))
def qang(k) = 5.2207 - 0.0048 * e3(k / 1236.85) * cos(rad(ms(k))) + 0.0020 * e3(k / 1236.85) * cos(rad(2 * ms(k))) - 0.3299 * cos(rad(mp(k))) - 0.0060 * e3(k / 1236.85) * cos(rad(mp(k) + ms(k))) + 0.0041 * e3(k / 1236.85) * cos(rad(mp(k) - ms(k)))
def gamma(k) = (pang(k) * cos(rad(f1(k))) + qang(k) * sin(rad(f1(k)))) * (1 - 0.0048 * abs(cos(rad(f1(k)))))
def uval(k) = 0.0059 + 0.0046 * e3(k / 1236.85) * cos(rad(ms(k))) - 0.0182 * cos(rad(mp(k))) + 0.0004 * cos(rad(2 * mp(k))) - 0.0005 * cos(rad(ms(k) + mp(k)))

// ---- the eclipse search: first lunation that passes both tests -----------------
def kind(k) = (if abs(gamma(k)) < 0.9972 then (if uval(k) < 0 then "total" else if uval(k) > 0.0047 then "annular" else "hybrid") else "partial")
def is_eclipse(k) = abs(sin(rad(mf(k)))) <= 0.36 and abs(gamma(k)) <= 1.5433 + uval(k)
def find(k, n) = if n == 0 then -1 else if is_eclipse(k) then k else find(k + 1, n - 1)
def mssep(j) = deg(acos(sin(rad(decl(11, j))) * sin(rad(decl(10, j))) + cos(rad(decl(11, j))) * cos(rad(decl(10, j))) * cos(rad(ra(11, j) - ra(10, j)))))

k0 = ceil(kb(jd(day[1], day[2], day[3])))
k = find(k0, maxscan)

// ---- results ------------------------------------------------------------------
print("searching from", iso(jd(day[1], day[2], day[3])))
print("next solar eclipse (lunation k):", k)
print("kind:", kind(k), ", gamma:", gamma(k))
ttd = tmax(k)
print("maximum eclipse:", iso(ttd - delta_t(ttd) / 86400), "UT")

/* Self-check, canon-style: NASA's Five Millennium Canon lists the
Feb 17 annular at TD 12:13:06, gamma -0.9743 and the Aug 12 total at
TD 17:47:06, gamma 0.8977; this engine's own ephemeris gives the
independent third opinion through the illuminated fraction at
maximum: the Sun is fully covered only when the Moon's disk covers
it, i.e. illum of the MOON reads 1 while its lit fraction is
meaningless - so the check line below shows the Moon-Sun separation
at maximum: well under a degree for a central eclipse. */
print("Moon-Sun separation at maximum:", mssep(ttd), "deg")

/* ---- expected output ----
= {2026, 1, 1}
= 25
= 322
= 323
= searching from 2026-01-01T00:00:00
= next solar eclipse (lunation k): 323
= kind: annular , gamma: -0.973790137956
= 2461089.00969
= maximum eclipse: 2026-02-17T12:12:48 UT
= Moon-Sun separation at maximum: 0.923871600674 deg
*/
