/* ============================================================================
next-lunar-eclipse.epher -- the next lunar eclipse, with magnitudes

Scans full moons forward from a start date and reports the next
lunar eclipse: penumbral and umbral magnitude, gamma, the instants
of greatest eclipse, and the semi-durations of the partial and total
phases. The machinery is chapter 54 of Jean Meeus, "Astronomical
Algorithms" (2nd ed., Willmann-Bell, 1998), full-moon branch: the
|sin F| <= 0.36 test, the shortened series for the time of maximum,
the P/Q projection for gamma, the shadow radii (penumbral 1.2848+u,
umbral 0.7403-u, in Earth radii) and Meeus's semi-duration formulas
with n = 0.5458 + 0.0400 cos M'. Times are TD; the built-in delta_t
converts to UT. Kind: umbral magnitude over 1 is a total eclipse,
over 0 a partial, at or under 0 penumbral only.

The community originals: ticalc.org's "Lunar Eclipses" (which finds
the month's eclipse for a year) and hpcalc.org's "Eclipses of Moon
and Sun" 1.0 for the HP Prime.

Accuracy: Meeus's grade for the method. Against NASA's Five
Millennium Canon for the two 2026 lunar eclipses: greatest eclipse
within about 15 seconds of the canon's TD, umbral magnitude within
0.005 (canon: 1.1507 on Mar 03, 0.9299 on Aug 28), semi-durations
within a couple of minutes.

Run it from a terminal:
  Linux (deb, rpm):  epher /usr/lib/epher/scripts/astronomy/eclipses/next-lunar-eclipse.epher
  Windows:           epher "$env:LOCALAPPDATA\epher\scripts\astronomy\eclipses\next-lunar-eclipse.epher"
  macOS:             epher /Applications/epher.app/Contents/Resources/scripts/astronomy/eclipses/next-lunar-eclipse.epher
In the REPL:             load one of the paths above

Knobs: the start date (the search begins at the full moon after it)
and how many lunations to allow.
============================================================================ */

// ---- the knobs ----------------------------------------------------------------
const day = {2026, 1, 1}       // search from here
const maxscan = 25             // lunations to try (a year has ~12.4)

// ---- Meeus ch. 49/54 mean elements in T = k / 1236.85 --------------------------
def e3(t) = 1 - 0.002516 * t - 0.0000074 * t ^ 2
def mp(k) = 201.5643 + 385.81693528 * k + 0.0107582 * (k / 1236.85) ^ 2 + 0.00001238 * (k / 1236.85) ^ 3 - 0.000000058 * (k / 1236.85) ^ 4
def ms(k) = 2.5534 + 29.10535670 * k - 0.0000014 * (k / 1236.85) ^ 2 - 0.00000011 * (k / 1236.85) ^ 3
def mf(k) = 160.7108 + 390.67050284 * k - 0.0016118 * (k / 1236.85) ^ 2 - 0.00000227 * (k / 1236.85) ^ 3 + 0.000000011 * (k / 1236.85) ^ 4
def node(k) = 124.7746 - 1.56375588 * k + 0.0020672 * (k / 1236.85) ^ 2 + 0.00000215 * (k / 1236.85) ^ 3
def base(k) = 2451550.09766 + 29.530588861 * k + 0.00015437 * (k / 1236.85) ^ 2 - 0.000000150 * (k / 1236.85) ^ 3 + 0.00000000073 * (k / 1236.85) ^ 4
def kb(j) = (j - 2451550.09766) / 29.530588861

// ---- ch. 54: time of maximum (TD), gamma and u at the full moon of lunation k --
def f1(k) = mf(k) - 0.02665 * sin(rad(node(k)))
def tmax(k) = base(k) - 0.4065 * sin(rad(mp(k))) + 0.1727 * e3(k / 1236.85) * sin(rad(ms(k))) + 0.0161 * sin(rad(2 * mp(k))) - 0.0097 * sin(rad(2 * f1(k))) + 0.0073 * e3(k / 1236.85) * sin(rad(mp(k) - ms(k))) - 0.0050 * e3(k / 1236.85) * sin(rad(mp(k) + ms(k))) - 0.0023 * sin(rad(mp(k) - 2 * f1(k))) + 0.0021 * e3(k / 1236.85) * sin(rad(2 * ms(k))) + 0.0012 * sin(rad(mp(k) + 2 * f1(k))) + 0.0006 * e3(k / 1236.85) * sin(rad(2 * mp(k) + ms(k))) - 0.0004 * sin(rad(3 * mp(k))) - 0.0003 * e3(k / 1236.85) * sin(rad(ms(k) + 2 * f1(k))) + 0.0003 * sin(rad(299.77 + 0.107408 * k)) - 0.0002 * e3(k / 1236.85) * sin(rad(ms(k) - 2 * f1(k))) - 0.0002 * e3(k / 1236.85) * sin(rad(2 * mp(k) - ms(k))) - 0.0002 * sin(rad(node(k)))
def pang(k) = 0.2070 * e3(k / 1236.85) * sin(rad(ms(k))) + 0.0024 * e3(k / 1236.85) * sin(rad(2 * ms(k))) - 0.0392 * sin(rad(mp(k))) + 0.0116 * sin(rad(2 * mp(k))) - 0.0073 * e3(k / 1236.85) * sin(rad(mp(k) + ms(k))) + 0.0067 * e3(k / 1236.85) * sin(rad(mp(k) - ms(k))) + 0.0118 * sin(rad(2 * f1(k)))
def qang(k) = 5.2207 - 0.0048 * e3(k / 1236.85) * cos(rad(ms(k))) + 0.0020 * e3(k / 1236.85) * cos(rad(2 * ms(k))) - 0.3299 * cos(rad(mp(k))) - 0.0060 * e3(k / 1236.85) * cos(rad(mp(k) + ms(k))) + 0.0041 * e3(k / 1236.85) * cos(rad(mp(k) - ms(k)))
def gamma(k) = (pang(k) * cos(rad(f1(k))) + qang(k) * sin(rad(f1(k)))) * (1 - 0.0048 * abs(cos(rad(f1(k)))))
def uval(k) = 0.0059 + 0.0046 * e3(k / 1236.85) * cos(rad(ms(k))) - 0.0182 * cos(rad(mp(k))) + 0.0004 * cos(rad(2 * mp(k))) - 0.0005 * cos(rad(ms(k) + mp(k)))

// ---- magnitudes and semi-durations (minutes) -----------------------------------
def penmag(k) = (1.5573 + uval(k) - abs(gamma(k))) / 0.5450
def ummag(k) = (1.0128 - uval(k) - abs(gamma(k))) / 0.5450
def rate(k) = 0.5458 + 0.0400 * cos(rad(mp(k)))
def semi(rad_r, k) = if rad_r * rad_r > gamma(k) * gamma(k) then 60 * sqrt(rad_r * rad_r - gamma(k) * gamma(k)) / rate(k) else 0
def kind(k) = if ummag(k) >= 1 then "total" else if ummag(k) > 0 then "partial" else "penumbral"

// ---- the search over full moons (lunations at k + 0.5) -------------------------
def is_eclipse(k) = abs(sin(rad(mf(k)))) <= 0.36 and abs(gamma(k)) <= 1.5433 + uval(k) and penmag(k) > 0
def find(k, n) = if n == 0 then -1 else if is_eclipse(k) then k else find(k + 1, n - 1)

k0 = ceil(kb(jd(day[1], day[2], day[3])) - 0.5) + 0.5
k = find(k0, maxscan)

// ---- results ------------------------------------------------------------------
print("searching from", iso(jd(day[1], day[2], day[3])))
print("next lunar eclipse (lunation k):", k)
print("kind:", kind(k), ", gamma:", gamma(k))
print("umbral magnitude:", ummag(k), ", penumbral magnitude:", penmag(k))
ttd = tmax(k)
print("greatest eclipse:", iso(ttd - delta_t(ttd) / 86400), "UT")
print("partial phase lasts", 2 * semi(1.0128 - uval(k), k) in min, "; totality", 2 * semi(0.4678 - uval(k), k) in min)

/* Self-check, canon-style: NASA's Five Millennium Canon lists the
2026 Mar 03 total eclipse at TD 11:34:52 (UT 11:33:37), gamma
-0.3765, umbral 1.1507; the engine's independent illum at greatest
eclipse must read the Moon fully inside the umbra. */
print("built-in illum of the Moon at greatest eclipse:", illum(11, ttd))

/* ---- expected output ----
= {2026, 1, 1}
= 25
= 321.5
= 323.5
= searching from 2026-01-01T00:00:00
= next lunar eclipse (lunation k): 323.5
= kind: total , gamma: -0.377342593068
= umbral magnitude: 1.14867362669 , penumbral magnitude: 2.18236272902
= 2168231728/881
= greatest eclipse: 2026-03-03T11:34:20 UT
= partial phase lasts 205.284519796 min ; totality 57.4581508869 min
= built-in illum of the Moon at greatest eclipse: 1
*/
