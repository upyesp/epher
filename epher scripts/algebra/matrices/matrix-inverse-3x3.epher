// ============================================================================
// matrix-inverse-3x3.epher -- inverse via the builtin inv, A A^-1 checked
//
// The built-in inv computes the inverse of a square matrix.
// The matrix M below was chosen with det M = 1, so its inverse is the
// integer matrix [[-24, 18, 5], [20, -15, -4], [-5, 4, 1]]. The built-in
// works in floating point, so M times inv(M) comes out as the identity up
// to rounding of about 1e-15; the helper adds the absolute errors of all
// nine entries, and the last line checks that sum is below 1e-9.
//
// Run it from a terminal:  epher "epher scripts/algebra/matrices/matrix-inverse-3x3.epher"
//
// The knob to edit is the matrix M below.
// ============================================================================

// ---- the knob ----------------------------------------------------------------
const M = [[1, 2, 3], [0, 1, 4], [5, 6, 0]]

// ---- helpers -----------------------------------------------------------------
// how far a matrix is from the 3x3 identity: sum of the entry errors
def ierr3(m) = abs(m[1][1] - 1) + abs(m[2][2] - 1) + abs(m[3][3] - 1) + abs(m[1][2]) + abs(m[1][3]) + abs(m[2][1]) + abs(m[2][3]) + abs(m[3][1]) + abs(m[3][2])

// ---- results -----------------------------------------------------------------
print("det:", det(M))
print("inverse by builtin inv:", inv(M))
print("M inv(M) within 1e-9 of identity:", ierr3(M * inv(M)) < 1e-9)
// ---- expected output ----
// = [[1, 2, 3], [0, 1, 4], [5, 6, 0]]
// = det: 1
// = inverse by builtin inv: [[-24, 18, 5], [20, -15, -4], [-5, 4, 1]]
// = M inv(M) within 1e-9 of identity: true
