/* ============================================================================
determinant-3x3.epher -- the 3x3 determinant by the rule of Sarrus

Sarrus' rule (Pierre Frederic Sarrus, 1833) computes a 3x3 determinant by
summing three downward diagonals and subtracting three upward ones. It
holds only for 3x3 matrices; larger determinants need expansion or row
reduction, which is why the built-in det exists. The classroom formula is
written out for teaching and checked against det. All values are exact.

Run it from a terminal:
  Linux (deb, rpm):  epher /usr/lib/epher/scripts/algebra/matrices/determinant-3x3.epher
  Windows:           epher "$env:LOCALAPPDATA\epher\scripts\algebra\matrices\determinant-3x3.epher"
  macOS:             epher /Applications/epher.app/Contents/Resources/scripts/algebra/matrices/determinant-3x3.epher

The knob to edit is the matrix M below.
============================================================================ */

// ---- the knob ----------------------------------------------------------------
const M = [[1, 2, 3], [4, 5, 6], [7, 8, 10]]

// ---- helpers -----------------------------------------------------------------
// Sarrus: aei + bfg + cdh - ceg - bdi - afh for rows (a b c)(d e f)(g h i)
def sarrus(a, b, c, d, e, f, g, h, i) = a * e * i + b * f * g + c * d * h - c * e * g - b * d * i - a * f * h

// ---- results -----------------------------------------------------------------
sv = sarrus(M[1][1], M[1][2], M[1][3], M[2][1], M[2][2], M[2][3], M[3][1], M[3][2], M[3][3])  // Sarrus value (echoes -3)
print("builtin det:", det(M))
print("they agree within 1e-12:", abs(sv - det(M)) < 1e-12)
/* ---- expected output ----
= [[1, 2, 3], [4, 5, 6], [7, 8, 10]]
= -3
= builtin det: -3
= they agree within 1e-12: true
*/
