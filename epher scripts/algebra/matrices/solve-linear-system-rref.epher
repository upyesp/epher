/* ============================================================================
   solve-linear-system-rref.epher -- 3 equations in 3 unknowns via rref

   The system 2x + 3y - z = -2/3, 4x + y + 2z = 3, -2x + 5y + 3z = -2/3 has
   the solution x = 1/2, y = -1/3, z = 2/3. Reduce the augmented matrix with
   the built-in rref: the last column of the reduced matrix holds the
   solution, and the entries stay exact rationals, so y and z print as the
   exact fractions -1/3 and 2/3. The last boolean puts the read-off solution
   back into the first row.

   Run it from a terminal:
     Linux (deb, rpm):  epher /usr/lib/epher/scripts/algebra/matrices/solve-linear-system-rref.epher
     Windows:           epher "$env:LOCALAPPDATA\epher\scripts\algebra\matrices\solve-linear-system-rref.epher"
     macOS:             epher /Applications/epher.app/Contents/Resources/scripts/algebra/matrices/solve-linear-system-rref.epher

   The knob to edit is the augmented matrix AM below.
   ============================================================================ */

// ---- the knob ----------------------------------------------------------------
const AM = [[2, 3, -1, -2/3], [4, 1, 2, 3], [-2, 5, 3, -2/3]]

// ---- results -----------------------------------------------------------------
R = rref(AM)                      // reduced row echelon form (echoes)
print("x:", R[1][4])
print("y:", R[2][4])
print("z:", R[3][4])
print("back in the first row:", 2 * R[1][4] + 3 * R[2][4] - R[3][4] == -2/3)
/* ---- expected output ----
= [[2, 3, -1, -2/3], [4, 1, 2, 3], [-2, 5, 3, -2/3]]
= [[1, 0, 0, 0.5], [0, 1, 0, -1/3], [0, 0, 1, 2/3]]
= x: 0.5
= y: -1/3
= z: 2/3
= back in the first row: true
*/
