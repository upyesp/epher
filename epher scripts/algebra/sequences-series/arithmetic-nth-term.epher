// ============================================================================
// arithmetic-nth-term.epher -- the n-th term of an arithmetic sequence
//
// An arithmetic sequence starts at a and adds the common difference d each
// step, so the n-th term is t_n = a + (n - 1) d (any algebra text, e.g.
// Stewart, Redlin and Watson, "College Algebra", 7th ed., sec. 9.1). With
// a = 3, d = 4 the sequence is 3, 7, 11, 15, ... and t_25 = 99. All values
// are exact.
//
// Run it from a terminal:  epher "epher scripts/algebra/sequences-series/arithmetic-nth-term.epher"
//
// The knobs to edit are a, d and n below.
// ============================================================================

// ---- the knobs ---------------------------------------------------------------
const a = 3                      // first term
const d = 4                      // common difference
const n = 25                     // term to find

// ---- helpers -----------------------------------------------------------------
def tn(a, d, n) = a + (n - 1) * d     // the n-th term

// ---- results -----------------------------------------------------------------
print("t1:", tn(a, d, 1))
print("t25:", tn(a, d, n))
print("t25 - t24:", tn(a, d, n) - tn(a, d, n - 1))
print("that difference is d:", tn(a, d, n) - tn(a, d, n - 1) == d)
// ---- expected output ----
// = 3
// = 4
// = 25
// = t1: 3
// = t25: 99
// = t25 - t24: 4
// = that difference is d: true
