/* ============================================================================
arithmetic-sum.epher -- sum of the first num terms of an arithmetic sequence

The sum of the first num terms of an arithmetic sequence is
S_n = num (t1 + tn) / 2, the Gauss pairing trick (legend has it Gauss added
1..100 this way at age seven; any algebra text, e.g. Stewart, Redlin and
Watson, "College Algebra", 7th ed., sec. 9.1). With a = 3, step = 4 the first
25 terms sum to 25 (3 + 99) / 2 = 1275, cross-checked by adding the terms
one by one in a quiet while loop. All values are exact.

Run it from a terminal:
  Linux (deb, rpm):  epher /usr/lib/epher/scripts/algebra/sequences-series/arithmetic-sum.epher
  Windows:           epher "$env:LOCALAPPDATA\epher\scripts\algebra\sequences-series\arithmetic-sum.epher"
  macOS:             epher /Applications/epher.app/Contents/Resources/scripts/algebra/sequences-series/arithmetic-sum.epher

The knobs to edit are a, step and num below.
============================================================================ */

// ---- the knobs ---------------------------------------------------------------
const a = 3                      // first term
const step = 4                      // common difference
const num = 25                     // number of terms to add

// ---- helpers -----------------------------------------------------------------
def tn(a, step, num) = a + (num - 1) * step                    // the num-th term
def sn(a, step, num) = num * (2 * a + (num - 1) * step) / 2      // num (t1 + tn) / 2

// ---- results -----------------------------------------------------------------
print("S25 by formula:", sn(a, step, num))
// add the terms one by one (a for loop would echo all 25 partial sums)
acc = {0, 0}
while acc[1] < num do acc = {acc[1] + 1, acc[2] + tn(a, step, acc[1] + 1)}
print("S25 by adding:", acc[2])
print("formula equals the sum:", sn(a, step, num) == acc[2])
print("Gauss pairing num (t1 + t25) / 2:", num * (tn(a, step, 1) + tn(a, step, num)) / 2)
/* ---- expected output ----
= 3
= 4
= 25
= S25 by formula: 1275
= {0, 0}
= S25 by adding: 1275
= formula equals the sum: true
= Gauss pairing num (t1 + t25) / 2: 1275
*/
