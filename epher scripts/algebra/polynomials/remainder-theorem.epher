// ============================================================================
// remainder-theorem.epher -- remainder of p(x) / (x - r) equals p(r)
//
// The remainder theorem: dividing p(x) by x - r leaves the remainder p(r)
// (any algebra text, e.g. Stewart, Redlin and Watson, "College Algebra",
// 7th ed., sec. 3.3). Verified two ways below: p(2) evaluated directly, and
// the synthetic-division carry chain, which also exposes the quotient
// q(x) = 2x^2 + 3x + 9 with p(x) = (x - 2) q(x) + 13. The loop version of
// the carry chain lives in synthetic-division.epher. All values are exact.
//
// Run it from a terminal:  epher "epher scripts/algebra/polynomials/remainder-theorem.epher"
//
// The knobs to edit are cs and r below.
// ============================================================================

// ---- the knobs ---------------------------------------------------------------
const cs = {2, -1, 3, -5}        // p(x) = 2x^3 - x^2 + 3x - 5
const r = 2                      // divide by (x - r) = (x - 2)

// ---- helpers -----------------------------------------------------------------
def p(cs, x) = cs[1] * x ^ 3 + cs[2] * x ^ 2 + cs[3] * x + cs[4]

// ---- results -----------------------------------------------------------------
// synthetic division, unrolled one coefficient at a time
q2 = cs[2] + r * cs[1]           // x-coefficient of the quotient (echoes 3)
q3 = cs[3] + r * q2              // constant term of the quotient (echoes 9)
rem = cs[4] + r * q3             // the remainder (echoes 13)
print("p(2):", p(cs, 2))
print("remainder equals p(r):", rem == p(cs, 2))
print("p = (x - r) q + rem holds at x = 1:", p(cs, 1) == (1 - r) * (cs[1] + q2 + q3) + rem)
// ---- expected output ----
// = {2, -1, 3, -5}
// = 2
// = 3
// = 9
// = 13
// = p(2): 13
// = remainder equals p(r): true
// = p = (x - r) q + rem holds at x = 1: true
