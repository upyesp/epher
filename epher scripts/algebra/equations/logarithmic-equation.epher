/* ============================================================================
   logarithmic-equation.epher -- solve ln(x) = 2.5 via the exponential

   Exponentiate both sides: x = e^2.5 (any algebra text, e.g. Stewart, Redlin
   and Watson, "College Algebra", 7th ed., sec. 5.5). The value is irrational,
   so it prints to about 12 significant digits; the last line checks that
   ln(x) comes back to 2.5 within 1e-12. The built-in solve could scan the
   equation numerically too; exponentiating is exact up to the final rounding.

   Run it from a terminal:  epher "epher scripts/algebra/equations/logarithmic-equation.epher"

   The knob to edit is rhs below.
   ============================================================================ */

// ---- the knob ----------------------------------------------------------------
const rhs = 2.5                            // solve ln(x) = rhs

// ---- helpers -----------------------------------------------------------------
def ex(rhs) = exp(rhs)                     // x = e^rhs

// ---- results -----------------------------------------------------------------
print("x:", ex(rhs))
print("ln(x):", ln(ex(rhs)))
print("ln(x) = 2.5 within 1e-12:", abs(ln(ex(rhs)) - rhs) < 1e-12)
/* ---- expected output ----
= 2.5
= x: 12.1824939607
= ln(x): 2.5
= ln(x) = 2.5 within 1e-12: true
*/
