/* ============================================================================
   quadratic-formula.epher -- real roots of ax^2 + bx + c via the quadratic formula

   The roots of a x^2 + b x + c = 0 are (-b +/- sqrt(b^2 - 4ac)) / (2a), the
   quadratic formula of every college-algebra text (Stewart, Redlin and Watson,
   "College Algebra", 7th ed., sec. 1.4). The discriminant b^2 - 4ac is
   positive here, so both roots are real. Whole-number coefficients make every
   printed value exact; the roots are checked by evaluating the polynomial.

   Run it from a terminal:
     Linux (deb, rpm):  epher /usr/lib/epher/scripts/algebra/equations/quadratic-formula.epher
     Windows:           epher "$env:LOCALAPPDATA\epher\scripts\algebra\equations\quadratic-formula.epher"
     macOS:             epher /Applications/epher.app/Contents/Resources/scripts/algebra/equations/quadratic-formula.epher

   The knobs to edit are a, b and c below.
   ============================================================================ */

// ---- the knobs ---------------------------------------------------------------
const a = 1
const b = -5
const c = 6

// ---- helpers -----------------------------------------------------------------
def disc(a, b, c) = b ^ 2 - 4 * a * c        // the discriminant b^2 - 4ac
def rplus(a, b, c) = (-b + sqrt(disc(a, b, c))) / (2 * a)  // root with the plus sign
def rminus(a, b, c) = (-b - sqrt(disc(a, b, c))) / (2 * a) // root with the minus sign
def p(a, b, c, x) = a * x ^ 2 + b * x + c    // the polynomial at x

// ---- results -----------------------------------------------------------------
print("discriminant:", disc(a, b, c))
print("root 1:", rplus(a, b, c))
print("root 2:", rminus(a, b, c))
print("p(root 1):", p(a, b, c, rplus(a, b, c)))
print("p(root 2):", p(a, b, c, rminus(a, b, c)))
print("roots sum to -b/a:", rplus(a, b, c) + rminus(a, b, c) == -b / a)
print("roots multiply to c/a:", rplus(a, b, c) * rminus(a, b, c) == c / a)
/* ---- expected output ----
= 1
= -5
= 6
= discriminant: 1
= root 1: 3
= root 2: 2
= p(root 1): 0
= p(root 2): 0
= roots sum to -b/a: true
= roots multiply to c/a: true
*/
