/* ============================================================================
   lcm-of-two-numbers.epher -- the least common multiple of pairs

   Calls the lcm builtin on several pairs and cross-checks it with the
   identity lcm(a, b) * gcd(a, b) = a * b, which ties the two builtins
   together (Hardy and Wright, ch. 1). The script uses the builtins; it
   does not reimplement them. The classic check is lcm(4, 6) = 12.

   Source: Hardy and Wright, "An Introduction to the Theory of Numbers",
   ch. 1. lcm and gcd are exact.

   Run it from a terminal:  epher "epher scripts/number-theory/divisors/lcm-of-two-numbers.epher"
   In the REPL:             load epher scripts/number-theory/divisors/lcm-of-two-numbers.epher
   Web/desktop:             paste the whole file into the entry, press Enter

   There is no knob: the sample pairs are the point of the script.
   ============================================================================ */

// ---- the classic check -----------------------------------------------------------
print("lcm(4, 6):", lcm(4, 6))              // 12: multiples 4, 8, 12 and 6, 12
print("lcm(12, 18):", lcm(12, 18))          // 36: 12 = 2^2 * 3, 18 = 2 * 3^2
print("lcm(21, 6):", lcm(21, 6))            // 42: 21 = 3 * 7, 6 = 2 * 3
print("lcm(15, 20):", lcm(15, 20))          // 60: 15 = 3 * 5, 20 = 2^2 * 5
print("lcm(7, 11):", lcm(7, 11))            // 77: coprime inputs multiply

// ---- the identity lcm(a, b) = a * b / gcd(a, b) ---------------------------------
print("4 * 6 / gcd(4, 6):", 4 * 6 / gcd(4, 6))        // 24 / 2 = 12, as above
print("12 * 18 / gcd(12, 18):", 12 * 18 / gcd(12, 18))  // 216 / 6 = 36
print("identity holds:", lcm(12, 18) == 12 * 18 / gcd(12, 18))
/* ---- expected output ----
= lcm(4, 6): 12
= lcm(12, 18): 36
= lcm(21, 6): 42
= lcm(15, 20): 60
= lcm(7, 11): 77
= 4 * 6 / gcd(4, 6): 12
= 12 * 18 / gcd(12, 18): 36
= identity holds: true
*/
