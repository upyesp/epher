/* ============================================================================
spherical-spiral.epher -- a Clelia: longitude in lockstep with latitude

Let the latitude run steadily from pole to pole while the longitude
turns k times: x = cos(t/2)*cos(4*t), y = cos(t/2)*sin(4*t),
z = sin(t/2). The curve never leaves the unit sphere - it is a
"Clelia", named for Grandi's Contessa Clelia Borromeo (Guido Grandi,
1728; MathWorld, "Spherical Spiral") - the seam pattern of a tennis
ball is its cousin. The script graphs it and checks the sphere
membership at sample points and the pole landings.

Run it from a terminal:
  Linux (deb, rpm):  epher /usr/lib/epher/scripts/graphs/space-curves/spherical-spiral.epher
  Windows:           epher "$env:LOCALAPPDATA\epher\scripts\graphs\space-curves\spherical-spiral.epher"
  macOS:             epher /Applications/epher.app/Contents/Resources/scripts/graphs/space-curves/spherical-spiral.epher
In the REPL:             load one of the paths above
Web/desktop:             paste the whole file into the entry, press Enter
The graph lines open the 3D pane in the desktop, web and TUI apps;
the CLI transcript records them as "graph3d:" lines.
============================================================================ */

// ---- the curve -----------------------------------------------------------------
def sx(t) = cos(t / 2) * cos(4 * t)
def sy(t) = cos(t / 2) * sin(4 * t)
def sz(t) = sin(t / 2)

// ---- results -------------------------------------------------------------------
print("on the unit sphere at t = 1.3:", sx(1.3) ^ 2 + sy(1.3) ^ 2 + sz(1.3) ^ 2)
print("lands on the north pole at t = pi:", sz(pi) == 1 and abs(sx(pi)) < 1e-15 and abs(sy(pi)) < 1e-15)
print("and on the south pole at t = -pi:", sz(0 - pi) == -1 and abs(sx(0 - pi)) < 1e-15)

// ---- the picture ---------------------------------------------------------------
graph3d param cos(t / 2) * cos(4 * t), cos(t / 2) * sin(4 * t), sin(t / 2) from -3.14159 to 3.14159

/* ---- expected output ----
= on the unit sphere at t = 1.3: 1
= lands on the north pole at t = pi: true
= and on the south pole at t = -pi: true
graph3d: param cos(t / 2) * cos(4 * t), cos(t / 2) * sin(4 * t), sin(t / 2) from -3.14159 to 3.14159
*/
