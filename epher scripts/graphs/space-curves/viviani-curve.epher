/* ============================================================================
viviani-curve.epher -- the window curve: sphere cut by cylinder

Viviani's curve (1692) is the intersection of a sphere of radius 2
centred at the origin with the cylinder (x-1)^2 + y^2 = 1 that
kisses the sphere's axis: x = 1 + cos(t), y = sin(t),
z = 2*sin(t/2). It is a figure eight riding on the sphere, crossing
itself at the top, and it is the classic curve whose arc length can
be found by elementary means (do Carmo, ch. 1, example 5; the
seventeenth-century story is in Lockwood, "A Book of Curves", ch. 17).
The script graphs it and checks both surface memberships.

Run it from a terminal:
  Linux (deb, rpm):  epher /usr/lib/epher/scripts/graphs/space-curves/viviani-curve.epher
  Windows:           epher "$env:LOCALAPPDATA\epher\scripts\graphs\space-curves\viviani-curve.epher"
  macOS:             epher /Applications/epher.app/Contents/Resources/scripts/graphs/space-curves/viviani-curve.epher
In the REPL:             load one of the paths above
Web/desktop:             paste the whole file into the entry, press Enter
The graph lines open the 3D pane in the desktop, web and TUI apps;
the CLI transcript records them as "graph3d:" lines.
============================================================================ */

// ---- the curve -----------------------------------------------------------------
def vx(t) = 1 + cos(t)
def vy(t) = sin(t)
def vz(t) = 2 * sin(t / 2)

// ---- results -------------------------------------------------------------------
print("on the sphere x^2 + y^2 + z^2 = 4, at t = 1.3:", vx(1.3) ^ 2 + vy(1.3) ^ 2 + vz(1.3) ^ 2)
print("on the cylinder (x-1)^2 + y^2 = 1, at t = 1.3:", (vx(1.3) - 1) ^ 2 + vy(1.3) ^ 2)
print("the self-crossing at t = pi:", vx(pi), vy(pi), vz(pi))

// ---- the picture ---------------------------------------------------------------
graph3d param 1 + cos(t), sin(t), 2 * sin(t / 2) from 0 to 12.566

/* ---- expected output ----
= on the sphere x^2 + y^2 + z^2 = 4, at t = 1.3: 4
= on the cylinder (x-1)^2 + y^2 = 1, at t = 1.3: 1
= the self-crossing at t = pi: 0 0.000000000000000122464679915 2
graph3d: param 1 + cos(t), sin(t), 2 * sin(t / 2) from 0 to 12.566
*/
