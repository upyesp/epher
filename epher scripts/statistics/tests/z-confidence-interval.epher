/* ============================================================================
   z-confidence-interval.epher -- the mean interval when sigma is known

   Builds a confidence interval for the mean of the ten exam scores in
   `d` with the builtin zinterval(data, sigma, level) (guide 1.20): the
   sample mean plus or minus the normal critical value times sigma /
   sqrt(n). The sigma knob is the population standard deviation, known
   here from past administrations of the exam; the level knob is the
   confidence level. Contrast the z interval with the t interval of
   t-confidence-interval.epher on the same data.

   Run it from a terminal:  epher "epher scripts/statistics/tests/z-confidence-interval.epher"
   In the REPL:             load epher scripts/statistics/tests/z-confidence-interval.epher
   Web/desktop:             paste the whole file into the entry, press Enter
   Everything also works line by line in the TUI.

   The knobs to edit are `sigma` and `level` below, or `d` for other
   data. Everything above the results section is machinery you can leave
   alone.
   ============================================================================ */

// ---- the knobs -----------------------------------------------------------------
const d = {72, 85, 91, 64, 88, 79, 83, 95, 70, 86}   // exam scores, 10 students
const sigma = 9     // the population stdev, known from past exams
const level = 0.95  // the confidence level, between 0 and 1

// ---- what feeds the interval ------------------------------------------------------------
print("sample mean:", mean(d))
print("standard error sigma / sqrt(n):", sigma / sqrt(len(d)))

// ---- the interval at the chosen level, and a wider one for contrast --------------------
zinterval(d, sigma, level)      // (75.7218, 86.8782): the 95% z interval
zinterval(d, sigma, 0.99)       // the 99% z interval is wider

/* ---- expected output ----
= {72, 85, 91, 64, 88, 79, 83, 95, 70, 86}
= 9
= 0.95
= sample mean: 81.3
= standard error sigma / sqrt(n): 2.84604989415
= (75.7218, 86.8782)
= (73.9691, 88.6309)
*/