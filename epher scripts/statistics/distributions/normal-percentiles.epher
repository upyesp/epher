/* ============================================================================
   normal-percentiles.epher -- cut points that leave a given area below

   The standard normal percentiles z such that P(Z <= z) equals the
   probability in `p`, from the builtin inverse normal invnorm(p, 0, 1)
   (guide 1.20). The 90th percentile is the familiar 1.2816, the 97.5th
   is the 1.96 of two-sided 95 percent intervals, and the 99th is 2.3263.
   The last three lines feed each percentile back through normcdf: the
   lower-tail area at the percentile comes back to p, as it must.

   Run it from a terminal:
     Linux (deb, rpm):  epher /usr/lib/epher/scripts/statistics/distributions/normal-percentiles.epher
     Windows:           epher "$env:LOCALAPPDATA\epher\scripts\statistics\distributions\normal-percentiles.epher"
     macOS:             epher /Applications/epher.app/Contents/Resources/scripts/statistics/distributions/normal-percentiles.epher
   In the REPL:             load one of the paths above
   Web/desktop:             paste the whole file into the entry, press Enter
   Everything also works line by line in the TUI.

   The knob to edit is `p` below. Everything above the results section is
   machinery you can leave alone.
   ============================================================================ */

// ---- the knob -----------------------------------------------------------------
const p = 0.90    // the lower-tail probability, between 0 and 1

// ---- the percentile at the chosen probability -----------------------------------
print("the p = 0.90 percentile:", invnorm(p))
print("the p = 0.975 percentile:", invnorm(0.975))
print("the p = 0.99 percentile:", invnorm(0.99))

// ---- each percentile fed back through the cdf comes back to its probability --------
print("normcdf(invnorm(p)):", normcdf(invnorm(p)))
print("normcdf(invnorm(0.975)):", normcdf(invnorm(0.975)))
print("normcdf(invnorm(0.99)):", normcdf(invnorm(0.99)))

/* ---- expected output ----
= 0.9
= the p = 0.90 percentile: 1.28155156554
= the p = 0.975 percentile: 1.95996398454
= the p = 0.99 percentile: 2.32634787404
= normcdf(invnorm(p)): 0.9
= normcdf(invnorm(0.975)): 0.975
= normcdf(invnorm(0.99)): 0.99
*/