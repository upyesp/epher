// ============================================================================
// sample-stdev.epher -- standard deviation of a sample with the n - 1 correction
//
// The sample standard deviation of the ten exam scores in `d`. The builtin
// stdev is the population version (divides by n), so the sample version
// (n - 1) is built from it as sqrt(variance(d) * n / (n - 1)); see
// sample-variance.epher for the variance alone. With ten scores the result
// is sqrt(2947/30), about 9.9113, against the population 9.4027 below.
//
// Run it from a terminal:  epher "epher scripts/statistics/summary/sample-stdev.epher"
// In the REPL:             load epher scripts/statistics/summary/sample-stdev.epher
// Web/desktop:             paste the whole file into the entry, press Enter
// Everything also works line by line in the TUI.
//
// The one knob to edit is `d` below. Everything above the results section
// is machinery you can leave alone.
// ============================================================================

// ---- the knob -----------------------------------------------------------------
const d = {72, 85, 91, 64, 88, 79, 83, 95, 70, 86}   // exam scores, 10 students

// ---- sample standard deviation: sqrt of the n - 1 variance ----------------------
sqrt(variance(d) * len(d) / (len(d) - 1))   // the n - 1 version of stdev
sqrt(sum((d - mean(d)) ^ 2) / (len(d) - 1)) // the formula directly, agrees
stdev(d)                                    // the population version for contrast

// ---- expected output ----
// = {72, 85, 91, 64, 88, 79, 83, 95, 70, 86}
// = 9.91127304302
// = 9.91127304302
// = 9.40265919833