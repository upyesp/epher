// ============================================================================
// z-scores.epher -- how many standard deviations a value sits from the mean
//
// The z-score of one exam score and of every score in `d`: z = (x - mean)
// / stdev, the distance from the mean in standard-deviation units. The
// list form uses epher's elementwise arithmetic (guide 1.20), so one
// expression standardizes the whole list. A z-score of 0.39 says the 85
// sits 0.39 population standard deviations above the class mean of 81.3.
// The stdev here is the population version (the builtin divides by n).
//
// Run it from a terminal:  epher "epher scripts/statistics/summary/z-scores.epher"
// In the REPL:             load epher scripts/statistics/summary/z-scores.epher
// Web/desktop:             paste the whole file into the entry, press Enter
// Everything also works line by line in the TUI.
//
// The one knob to edit is `d` below. Everything above the results section
// is machinery you can leave alone.
// ============================================================================

// ---- the knob -----------------------------------------------------------------
const d = {72, 85, 91, 64, 88, 79, 83, 95, 70, 86}   // exam scores, 10 students

// ---- helpers: z of one value and of the whole list -------------------------------
def z(x) = (x - mean(d)) / stdev(d)     /* z-score of score x against the class */

// ---- z of a single score ---------------------------------------------------------
z(85)                       // 85 sits 0.39 sd above the mean of 81.3

// ---- z of the whole list: elementwise (d - mean(d)) / stdev(d) -------------------
(d - mean(d)) / stdev(d)    // the standardized scores; they average 0 with sd 1

// ---- expected output ----
// = {72, 85, 91, 64, 88, 79, 83, 95, 70, 86}
// = 0.393505701095
// = {-0.989081897348, 0.393505701095, 1.03162305422, -1.83990503485, 0.712564377659, -0.244611652032, 0.180799916719, 1.45703462297, -1.20178768172, 0.499858593283}