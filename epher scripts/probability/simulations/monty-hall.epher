// ============================================================================
// monty-hall.epher -- 10000 games: switching wins two thirds of the time
//
// In the Monty Hall game a prize hides behind one of three doors. The
// player picks a door, the host opens a losing door, and the player may
// switch. By symmetry the player's first door can be fixed as door 1,
// and then one draw settles each game: if the prize is behind door 1
// (probability 1/3) staying wins; if it is behind door 2 or 3 (two
// thirds of games) the host is forced to open the other losing door and
// switching collects the prize.
//
// So the simulation only needs the prize door, randint(1, 3), and it
// counts staying wins; the switching wins are the complement of the
// same games, 10000 minus the count. The seeded run (randseed(13))
// should show a staying rate near 1/3 and a switching rate near 2/3,
// within about 0.015 of each target, and the stream is reproducible.
//
// Source: vos Savant (1990) column and the ensuing debate; the clean
// formulation here follows Ross, "A First Course in Probability",
// chapter 3.
//
// Run it from a terminal:  epher "epher scripts/probability/simulations/monty-hall.epher"
// Web/desktop:             paste the file into the entry, press Enter
//
// The knob to edit is `games`; everything below it is machinery.
// ============================================================================

// ---- the knobs ----
const games = 10000

// ---- results ----
// The player always picks door 1 first. Each game draws the prize door:
// door 1 wins for staying, doors 2 and 3 win for switching.
randseed(13)
v = {0, 0}
while v[1] < games do v = {v[1] + 1, v[2] + (if randint(1, 3) == 1 then 1 else 0)}

// The two strategies over the same games: staying wins v[2] of them,
// switching wins the other games - v[2].
print("games:", games)
print("staying wins:", v[2], "games")
print("switching wins:", games - v[2], "games")
print("staying rate:", v[2] / games)
print("switching rate:", (games - v[2]) / games)
print("theoretical rates: 1/3 staying, 2/3 switching:", 1/3, 2/3)

// The verdict: switching doubles the chance of the prize, from one in
// three to two in three, because the host's open door carries information
// whenever the first pick was wrong.
if v[2] * 2 < games then "switching wins: the host's door leaks information" else "check the seed"
// ---- expected output ----
// = 10000
// = 13
// = {0, 0}
// = games: 10000
// = staying wins: 3282 games
// = switching wins: 6718 games
// = staying rate: 0.3282
// = switching rate: 0.6718
// = theoretical rates: 1/3 staying, 2/3 switching: 1/3 2/3
// = switching wins: the host's door leaks information
