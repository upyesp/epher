/* ============================================================================
committee-selection.epher -- counting committees with ncr and npr

A committee is an unordered set, so ncr does the counting; adding an
office (chair, secretary) turns part of the choice into an ordered one
and npr takes over. This script walks through the standard scenarios
of a first probability course:

  - a committee of 3 from 8 people:            ncr(8, 3)
  - the same, but one member is the chair:     8 * ncr(7, 2)
  - 3 men and 2 women from 5 men and 6 women:  ncr(5, 3) * ncr(6, 2)
  - 3 of 8 with distinct offices:              npr(8, 3)
  - 3 of 8 with at least one of two named      ncr(8, 3) - ncr(6, 3)
    people included (all committees minus the
    ones that avoid both)

Source: Ross, "A First Course in Probability", chapter 1. All counts
are exact integers.

Run it from a terminal:
  Linux (deb, rpm):  epher /usr/lib/epher/scripts/probability/counting/committee-selection.epher
  Windows:           epher "$env:LOCALAPPDATA\epher\scripts\probability\counting\committee-selection.epher"
  macOS:             epher /Applications/epher.app/Contents/Resources/scripts/probability/counting/committee-selection.epher
Web/desktop:             paste the file into the entry, press Enter

The knob to edit is `group`; everything below it is machinery.
============================================================================ */

// ---- the knob ----
const group = 8

// ---- results ----
// A plain committee of 3 from `group` people: order does not matter.
print("committees of 3 from", group, ":", ncr(group, 3))

// One member chairs it: choose the chair first (8 ways), then the other
// two from the remaining 7. The count grows because the chair's role
// makes each committee of 3 count 3 times, once per possible chair.
print("with a chair:", group * ncr(group - 1, 2))
print("the same as 3 * ncr(8, 3):", group * ncr(group - 1, 2) == 3 * ncr(group, 3))

// Two quotas: 3 men from 5 and 2 women from 6, multiplied together.
print("3 men and 2 women (5 men, 6 women):", ncr(5, 3) * ncr(6, 2))

// Distinct offices: president, secretary, treasurer is an ordered list.
print("3 distinct offices among", group, "members:", npr(group, 3))

// With two named people, a committee of 3 that must include at least one
// of them: total committees minus the ncr(6, 3) with neither.
print("3 of", group, "including at least one of two named:", ncr(group, 3) - ncr(group - 2, 3))

// A probability that uses the same counts: if the 3 are chosen at random
// from the 8, the chance both named people are left out is ncr(6, 3)
// over ncr(8, 3), an exact fraction.
print("P(neither named person chosen):", ncr(6, 3) / ncr(8, 3))
/* ---- expected output ----
= 8
= committees of 3 from 8 : 56
= with a chair: 168
= the same as 3 * ncr(8, 3): true
= 3 men and 2 women (5 men, 6 women): 150
= 3 distinct offices among 8 members: 336
= 3 of 8 including at least one of two named: 36
= P(neither named person chosen): 5/14
*/
