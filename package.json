{
  "name": "epher-site",
  "private": true,
  "type": "module",
  "description": "Build tooling for the epher.org landing page and user guides",
  "scripts": {
    "build:guide": "node scripts/build-guide.mjs",
    "build:examples": "node scripts/build-examples.mjs",
    "build:scripts": "node scripts/build-scripts.mjs",
    "build:reference": "node scripts/build-reference.mjs",
    "audit:a11y": "node scripts/a11y/audit.mjs",
    "audit:vo": "node scripts/a11y/voiceover-audit.mjs --vo",
    "build:pwa": "cd crates/web && trunk build"
  },
  "dependencies": {
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "@guidepup/guidepup": "0.37.0",
    "axe-core": "4.13.0",
    "puppeteer": "25.9.0"
  }
}
