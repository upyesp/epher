<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <!-- ADR-0069: the .epher script file. The .desktop entry's MimeType=
       references this type, so the package must install its definition;
       postinst refreshes the mime database. -->
  <mime-type type="application/x-epher">
    <comment>epher calculation script</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.epher"/>
  </mime-type>
</mime-info>
